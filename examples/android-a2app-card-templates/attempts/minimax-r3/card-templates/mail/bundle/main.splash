// Mail card template — dev.studio.cards.mail
// All records are SYNTHETIC DEMO DATA held in this app's local list.
// No mailbox, no account, no network. "Send (demo)" appends to the local
// demo Sent list only; nothing is ever transmitted.
//
// Depths are PRESENTATION depths (UI), not parser levels:
//   L0  compact glance card
//   L1  expanded actionable card
//   L2  full app view (reader + demo inbox + reply composer)

let msgs = [
    {id: "m1" from: "Ana Ruiz" subject: "Contract renewal - signature by Friday"
        preview: "The revised payment terms are in the attached PDF. Can you confirm we can sign by Friday?"
        body: "The revised payment terms are in the attached PDF: net 45 instead of net 30, and the renewal window moves to 60 days. Can we sign by Friday?"
        at: "09:12" tag: "Work" att: true unread: true}
    {id: "m2" from: "City Library" subject: "Hold ready: your request is available"
        preview: "Three books from your request are on the holds shelf until Saturday."
        body: "Three books from your request are on the holds shelf until Saturday. The reading room closes at 20:00."
        at: "08:47" tag: "Personal" att: false unread: true}
    {id: "m3" from: "Priya N." subject: "Design review moved to Thursday 10:00"
        preview: "Pushed to Thursday so Marcus can join. Same room, notes in the shared doc."
        body: "Pushed the design review to Thursday 10:00 so Marcus can join. Same room as before."
        at: "Yesterday" tag: "Work" att: false unread: false}
    {id: "m4" from: "Northwind Studio" subject: "Invoice 2291 - August retainer"
        preview: "Amount due 1,480.00, payable within 14 days. Details in the PDF statement."
        body: "Invoice 2291 for the August retainer. Amount due 1,480.00, payable within 14 days."
        at: "Mon" tag: "Finance" att: false unread: false}
]

let ground = #xf2f2f7
let surface = #xffffff
let ink = #x1c1c1e
let ink2 = #x3c3c43
let muted = #x8e8e93
let accent = #x007aff
let danger = #xd70015
let line = #xe5e5ea
let demo_bg = #xfff3cd
let demo_ink = #x8a0b00

let archived = []
let drafts = []
let sent = []
let last_id = ""
let status = "Demo inbox."
let depth = 0
let sel = "m1"

// ---------- state helpers ----------

fn has_item(list, x){ for v in list { if v == x { return true } } false }

fn pick(cond, on, off){ if cond { on } else { off } }

fn msg_of(id){
    for m in msgs { if m.id == id { return m } }
    nil
}

fn n_rows(){
    let n = 0
    for m in msgs { if !has_item(archived, m.id) { n = n + 1 } }
    n
}

fn n_unread(){
    let n = 0
    for m in msgs { if !has_item(archived, m.id) && m.unread { n = n + 1 } }
    n
}

fn lead(){
    for m in msgs { if !has_item(archived, m.id) { return m } }
    nil
}

fn lead_id(){
    let m = lead()
    if m == nil { return "" }
    m.id
}

fn unread_str(id){
    for m in msgs {
        if m.id == id {
            if m.unread { return "Unread" }
            return "Read"
        }
    }
    ""
}

fn sel_archived(){ has_item(archived, sel) }

// A draft belongs to the message it was typed for, so selecting a different
// message never shows another one's text.
fn draft_of(id){
    for d in drafts { if d.id == id { return d.text } }
    ""
}

fn set_draft(id, t){
    for d in drafts { if d.id == id { d.text = t; return } }
    drafts.push({id: id text: t})
}

fn say(s){ status = s; ui.status.set_text(s) }

fn depth_name(){
    if depth == 0 { return "L0 · compact glance" }
    if depth == 1 { return "L1 · expanded card" }
    return "L2 · full app"
}

fn set_depth(d){
    depth = d
    say("Showing " + depth_name())
    sync()
}

// ---------- local actions ----------

fn do_archive(id){
    if has_item(archived, id) { return }
    archived.push(id)
    last_id = id
    say("Archived (demo) · tap Undo")
    sync()
}

fn do_undo(){
    if last_id == "" { say("Nothing to undo."); return }
    if !has_item(archived, last_id) { last_id = ""; say("Nothing to undo."); return }
    archived.retain(|x| x != last_id)
    last_id = ""
    say("Restored to Inbox (demo)")
    sync()
}

fn do_read(id){
    for m in msgs { if m.id == id { m.unread = !m.unread } }
    if unread_str(id) == "Unread" { say("Marked unread (demo)") } else { say("Marked read (demo)") }
    sync()
}

fn do_open(id){
    sel = id
    set_depth(1)
}

fn do_reply(id){
    sel = id
    set_depth(2)
}

fn do_send(){
    let m = msg_of(sel)
    if m == nil { say("Pick a message first"); return }
    if has_item(archived, m.id) { say("Unarchive before replying (demo)"); return }
    let body = draft_of(m.id).trim()
    if body == "" { say("Nothing to send · write a reply first"); return }
    sent.push({to: m.from subject: "Re: " + m.subject preview: body})
    set_draft(m.id, "")
    say("Sent (demo) to " + m.from)
    sync()
}

// ---------- chrome sync ----------

fn sync(){
    ui.glance.set_visible(depth == 0)
    ui.expanded.set_visible(depth == 1)
    ui.full.set_visible(depth == 2)

    ui.count.set_text("" + n_rows() + " in Inbox · " + "" + n_unread() + " unread")
    ui.depth_now.set_text("Showing " + depth_name())

    let m = lead()
    if m == nil {
        ui.g_card.set_visible(false)
        ui.g_empty.set_visible(true)
    } else {
        ui.g_card.set_visible(true)
        ui.g_empty.set_visible(false)
        ui.g_from.set_text(m.from)
        ui.g_time.set_text(m.at)
        ui.g_subj.set_text(m.subject)
        ui.g_prev.set_text(m.preview)
        ui.g_meta.set_text(m.tag + " · " + pick(m.unread, "Unread", "Read"))
    }

    // L1: the card is only live when the selected message is really in the inbox
    let s = msg_of(sel)
    let live = false
    if s != nil && !has_item(archived, s.id) { live = true }
    ui.x_card.set_visible(live)
    ui.x_gone.set_visible(!live)
    if live {
        ui.x_from.set_text(s.from)
        ui.x_time.set_text(s.at)
        ui.x_subj.set_text(s.subject)
        ui.x_meta.set_text(s.tag + " · " + pick(s.unread, "Unread", "Read") + " · " + pick(s.att, "1 attachment", "no attachment"))
        ui.x_prev.set_text(s.preview)
    }

    ui.r1.set_visible(!has_item(archived, "m1"))
    ui.r2.set_visible(!has_item(archived, "m2"))
    ui.r3.set_visible(!has_item(archived, "m3"))
    ui.r4.set_visible(!has_item(archived, "m4"))
    ui.r1_u.set_text(unread_str("m1"))
    ui.r2_u.set_text(unread_str("m2"))
    ui.r3_u.set_text(unread_str("m3"))
    ui.r4_u.set_text(unread_str("m4"))

    // reader + composer follow the selection
    let r = msg_of(sel)
    if r != nil {
        ui.rd_from.set_text(r.from + " · " + r.at)
        ui.rd_subj.set_text(r.subject)
        ui.rd_body.set_text(r.body)
        ui.cmp_to.set_text("To " + r.from)
        ui.cmp_subj.set_text("Re: " + r.subject)
    }
    ui.field.set_text(draft_of(sel))

    if sent.len() > 0 {
        ui.sent_card.set_visible(true)
        let last = sent[sent.len() - 1]
        ui.sent_count.set_text("" + sent.len())
        ui.sent_to.set_text("To " + last.to + " · " + last.subject)
        ui.sent_prev.set_text(last.preview)
    } else {
        ui.sent_card.set_visible(false)
    }
}

// ---------- shared button styles ----------

let Flat = ButtonFlat{height: 44 padding: Inset{left: 12 right: 12} align: Align{x: 0.5 y: 0.5}
    draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: accent color_hover: accent color_down: accent text_style +: {font_size: 15}}}

let DangerFlat = ButtonFlat{height: 44 padding: Inset{left: 12 right: 12} align: Align{x: 0.5 y: 0.5}
    draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: danger color_hover: danger color_down: danger text_style +: {font_size: 15}}}

let Seg = ButtonFlat{height: 44 width: Fill align: Align{x: 0.5 y: 0.5}
    draw_bg +: {color: #x00000000 color_hover: #x0000000f color_down: #x0000001a border_size: 0.0}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 14}}}

let Chip = ButtonFlat{height: 44 padding: Inset{left: 10 right: 10} align: Align{x: 0.5 y: 0.5}
    draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: ink2 color_hover: ink2 color_down: ink2 text_style +: {font_size: 13}}}

// ---------- root ----------

SolidView{width: Fill height: Fill flow: Down draw_bg.color: ground

    // chrome
    View{width: Fill height: Fit flow: Down spacing: 2
        padding: Inset{left: 16 right: 16 top: 12 bottom: 8}
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
            Label{text: "Mail" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 21}}
            View{width: Fill height: 1}
            RoundedView{width: Fit height: Fit
                padding: Inset{left: 8 right: 8 top: 3 bottom: 3}
                draw_bg.color: demo_bg draw_bg.border_radius: 6.0
                Label{text: "DEMO" draw_text.color: demo_ink draw_text.text_style: theme.font_bold{font_size: 11}}
            }
        }
        count := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
    }

    View{width: Fill height: Fill flow: Down

        // ===== L0 : compact glance =====
        glance := View{width: Fill height: Fill flow: Down spacing: 10
            padding: Inset{left: 16 right: 16 top: 4 bottom: 8}
            g_card := RoundedView{width: Fill height: Fit flow: Down spacing: 4
                padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                draw_bg.color: surface draw_bg.border_radius: 14.0
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    g_from := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                    g_time := Label{text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
                }
                g_subj := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 13}
                g_prev := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 13}
                g_meta := Label{text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 12}}
            }
            g_empty := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 4
                padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                draw_bg.color: surface draw_bg.border_radius: 14.0
                Label{width: Fill text: "No demo messages" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                Label{width: Fill text: "Everything is archived (demo)." draw_text.color: ink2 draw_text.text_style.font_size: 13}
            }
            View{width: Fill height: 1}
            View{width: Fill height: Fit flow: Right spacing: 8
                Flat{text: "Open card" on_click: || do_open(lead_id())}
                Flat{text: "Full app" on_click: || set_depth(2)}
            }
        }

        // ===== L1 : expanded actionable card =====
        expanded := View{visible: false width: Fill height: Fill flow: Down spacing: 10
            padding: Inset{left: 16 right: 16 top: 4 bottom: 8}
            x_card := RoundedView{width: Fill height: Fit flow: Down spacing: 4
                padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                draw_bg.color: surface draw_bg.border_radius: 14.0
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    x_from := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                    x_time := Label{text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
                }
                x_subj := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                x_meta := Label{text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
                SolidView{width: Fill height: 1 draw_bg.color: line}
                x_prev := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 14}
            }
            x_gone := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 4
                padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                draw_bg.color: surface draw_bg.border_radius: 14.0
                Label{width: Fill text: "Message archived (demo)" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                Label{width: Fill text: "Use Undo below, or open another message in the full app." draw_text.color: ink2 draw_text.text_style.font_size: 13}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                DangerFlat{text: "Archive" on_click: || do_archive(sel)}
                Flat{text: "Toggle read" on_click: || do_read(sel)}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                Flat{text: "Reply (demo)" on_click: || do_reply(sel)}
                Flat{text: "Full app" on_click: || set_depth(2)}
            }
            View{width: Fill height: 1}
            View{width: Fill height: Fit flow: Right spacing: 8
                Flat{text: "‹ Glance" on_click: || set_depth(0)}
            }
        }

        // ===== L2 : full app view =====
        full := View{visible: false width: Fill height: Fill flow: Down spacing: 8
            padding: Inset{left: 16 right: 16 top: 4 bottom: 4}
            // reader — the full body of the selected message
            RoundedView{width: Fill height: Fit flow: Down spacing: 3
                padding: Inset{left: 14 right: 14 top: 8 bottom: 8}
                draw_bg.color: surface draw_bg.border_radius: 14.0
                rd_from := Label{text: "" draw_text.color: demo_ink draw_text.text_style: theme.font_bold{font_size: 11}}
                rd_subj := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                rd_body := Label{width: Fill height: 64 text: "" draw_text.color: ink2 draw_text.text_style.font_size: 13}
            }
            // compact inbox rows — one 44pt Open each
            r1 := View{width: Fill height: Fit
                RoundedView{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                    draw_bg.color: surface draw_bg.border_radius: 10.0
                    Label{width: Fill text: "Ana Ruiz" draw_text.color: ink draw_text.text_style.font_size: 13}
                    r1_u := Label{text: "Unread" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 12}}
                    Flat{text: "Open" on_click: || do_open("m1")}
                }
            }
            r2 := View{width: Fill height: Fit
                RoundedView{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                    draw_bg.color: surface draw_bg.border_radius: 10.0
                    Label{width: Fill text: "City Library" draw_text.color: ink draw_text.text_style.font_size: 13}
                    r2_u := Label{text: "Unread" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 12}}
                    Flat{text: "Open" on_click: || do_open("m2")}
                }
            }
            r3 := View{width: Fill height: Fit
                RoundedView{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                    draw_bg.color: surface draw_bg.border_radius: 10.0
                    Label{width: Fill text: "Priya N." draw_text.color: ink draw_text.text_style.font_size: 13}
                    r3_u := Label{text: "Read" draw_text.color: muted draw_text.text_style.font_size: 12}
                    Flat{text: "Open" on_click: || do_open("m3")}
                }
            }
            r4 := View{width: Fill height: Fit
                RoundedView{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                    draw_bg.color: surface draw_bg.border_radius: 10.0
                    Label{width: Fill text: "Northwind Studio" draw_text.color: ink draw_text.text_style.font_size: 13}
                    r4_u := Label{text: "Read" draw_text.color: muted draw_text.text_style.font_size: 12}
                    Flat{text: "Open" on_click: || do_open("m4")}
                }
            }
            // composer, addressed to the selected message
            RoundedView{width: Fill height: Fit flow: Down spacing: 4
                padding: Inset{left: 14 right: 14 top: 8 bottom: 8}
                draw_bg.color: surface draw_bg.border_radius: 14.0
                cmp_to := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12}}
                cmp_subj := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
                field := TextInput{width: Fill height: 44
                    on_change: |t| set_draft(sel, t)}
                View{width: Fill height: Fit flow: Right spacing: 8
                    Flat{text: "Send (demo)" on_click: || do_send()}
                }
            }
            sent_card := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 2
                padding: Inset{left: 14 right: 14 top: 8 bottom: 8}
                draw_bg.color: surface draw_bg.border_radius: 14.0
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    Label{text: "SENT · DEMO" draw_text.color: demo_ink draw_text.text_style: theme.font_bold{font_size: 11}}
                    sent_count := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
                }
                sent_to := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 13}
                sent_prev := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 12}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                Flat{text: "‹ Glance" on_click: || set_depth(0)}
                Flat{text: "Card" on_click: || set_depth(1)}
            }
        }
    }

    // ---------- bottom bar ----------
    View{width: Fill height: Fit flow: Down spacing: 4
        padding: Inset{left: 16 right: 16 top: 6 bottom: 8}
        SolidView{width: Fill height: 1 draw_bg.color: line}
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
            depth_now := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12}}
            Chip{text: "Undo" on_click: || do_undo()}
        }
        RoundedView{width: Fill height: Fit flow: Right spacing: 4
            padding: Inset{left: 4 right: 4 top: 4 bottom: 4}
            draw_bg.color: #xe5e5ea draw_bg.border_radius: 12.0
            b0 := Seg{text: "L0 Glance" on_click: || set_depth(0)}
            b1 := Seg{text: "L1 Card" on_click: || set_depth(1)}
            b2 := Seg{text: "L2 App" on_click: || set_depth(2)}
        }
        status := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
    }
}

fn boot(){
    say("Showing L0 · compact glance")
    sync()
}

start_timeout(0.05, || boot())
