// News card template — dev.studio.cards.news
// All stories are SYNTHETIC DEMO DATA in this app's local list. Nothing is
// fetched, no live feed is read, and no article page is opened: the body shown
// here is a demo summary written with the record, not a retrieved article.
//
// Depths are PRESENTATION depths (UI), not parser levels:
//   L0  lead story at a glance
//   L1  expanded story with a reversible Save
//   L2  feed (All / Saved) -> story detail

let stories = [
    {id: "n1" title: "Riverside bridge reopens after inspection" outlet: "Harbour Times"
        at: "08:20" tag: "Local" points: 142 comments: 31
        brief: "Mill Street bridge reopens today after a six-day structural inspection."
        body: "The pedestrian bridge on Mill Street reopens today after a six-day structural inspection. Engineers replaced two corroded lower joints. The council says the bridge is back to full capacity and the temporary shuttle has been retired. This is a demo summary, not a fetched article."}
    {id: "n2" title: "Library extends weekend hours" outlet: "Harbour Times"
        at: "07:55" tag: "Local" points: 88 comments: 12
        brief: "Saturday opening moves to 09:00-19:00 from November."
        body: "From November the central library will open on Saturdays until 19:00, two hours later than now, funded by two extra weekend posts. Reading room capacity is unchanged at 240. Demo summary, not a fetched article."}
    {id: "n3" title: "Docklands solar trial powers first block" outlet: "Field Notes"
        at: "Yesterday" tag: "Energy" points: 264 comments: 57
        brief: "A rooftop array on the old warehouse now covers block demand."
        body: "A rooftop solar array on the old grain warehouse began supplying the surrounding block this week, the first shared scheme in the district. Early figures suggest it covers roughly sixty per cent of daytime demand for the four streets around it. Demo summary, not a fetched article."}
]

let ground = #xf2f2f7
let surface = #xffffff
let ink = #x1c1c1e
let ink2 = #x3c3c43
let muted = #x8e8e93
let accent = #x007aff
let line = #xe5e5ea
let demo_bg = #xfff3cd
let demo_ink = #x8a0b00

let saved = []
let status = "Demo feed."
let depth = 0
let sel = "n1"
let route = "list"
let tab = "all"

// ---------- state helpers ----------

fn pick(cond, on, off){ if cond { on } else { off } }

fn st_of(id){
    for s in stories { if s.id == id { return s } }
    nil
}

fn is_saved(id){
    for s in saved { if s == id { return true } }
    false
}

fn n_saved(){ saved.len() }

fn lead(){
    for s in stories { return s }
    nil
}

fn say(s){ status = s; ui.status.set_text(s) }

fn depth_name(){
    if depth == 0 { return "L0 Glance" }
    if depth == 1 { return "L1 Story" }
    if route == "detail" { return "L2 Story" }
    return "L2 Feed"
}

fn set_depth(d){
    depth = d
    route = "list"
    say("")
    sync()
}

fn do_open(id){
    sel = id
    route = "detail"
    set_depth(2)
    route = "detail"
    sync()
}

fn do_back(){
    route = "list"
    say("")
    sync()
}

fn do_save(id){
    if is_saved(id) { return }
    saved.push(id)
    let s = st_of(id)
    if s == nil { return }
    say("Saved " + s.outlet)
    sync()
}

fn do_remove(id){
    if !is_saved(id) { return }
    saved.retain(|x| x != id)
    let s = st_of(id)
    if s == nil { return }
    say("Removed from Saved · " + s.outlet)
    sync()
}

// The dynamically labelled button must do what its current label says, so one
// action serves both directions and stays reversible in L1 and in detail.
fn do_toggle_saved(id){
    if is_saved(id) { do_remove(id) } else { do_save(id) }
}

fn set_tab(t){
    tab = t
    say("Showing " + pick(t == "all", "All stories", "Saved"))
    sync()
}

// ---------- chrome sync ----------

fn sync(){
    ui.glance.set_visible(depth == 0)
    ui.expanded.set_visible(depth == 1)
    ui.full.set_visible(depth == 2)

    ui.count.set_text("" + stories.len() + " stories · " + "" + n_saved() + " saved")
    ui.status.set_text(status)
    ui.b0.set_text(pick(depth == 0, "● L0", "L0"))
    ui.b1.set_text(pick(depth == 1, "● L1", "L1"))
    ui.b2.set_text(pick(depth == 2, "● L2", "L2"))

    let m = lead()
    ui.g_outlet.set_text(m.outlet)
    ui.g_at.set_text(m.at)
    ui.g_title.set_text(m.title)
    ui.g_brief.set_text(m.brief)
    ui.g_meta.set_text(m.tag + " · " + "" + m.points + " pts")

    let s = st_of(sel)
    ui.x_outlet.set_text(s.outlet + " · " + s.at)
    ui.x_title.set_text(s.title)
    ui.x_meta.set_text(s.tag + " · " + "" + s.points + " pts · " + "" + s.comments + " comments")
    ui.x_brief.set_text(s.brief)
    ui.x_action.set_text(pick(is_saved(s.id), "Remove from Saved", "Save"))

    ui.rd_outlet.set_text(s.outlet + " · " + s.at)
    ui.rd_title.set_text(s.title)
    ui.rd_meta.set_text(s.tag + " · " + "" + s.points + " pts · " + "" + s.comments + " comments")
    ui.rd_body.set_text(s.body)
    ui.rd_action.set_text(pick(is_saved(s.id), "Remove from Saved", "Save"))

    ui.l2_list.set_visible(route == "list")
    ui.l2_detail.set_visible(route == "detail")

    ui.r1.set_visible(tab == "all")
    ui.r2.set_visible(tab == "all")
    ui.r3.set_visible(tab == "all")
    ui.r1_s.set_visible(tab == "saved" && is_saved("n1"))
    ui.r2_s.set_visible(tab == "saved" && is_saved("n2"))
    ui.r3_s.set_visible(tab == "saved" && is_saved("n3"))
    ui.saved_empty.set_visible(tab == "saved" && n_saved() == 0)

    ui.r1_b.set_text(pick(is_saved("n1"), "Remove", "Save"))
    ui.r2_b.set_text(pick(is_saved("n2"), "Remove", "Save"))
    ui.r3_b.set_text(pick(is_saved("n3"), "Remove", "Save"))
    ui.r1_sb.set_text(pick(is_saved("n1"), "Remove", "Save"))
    ui.r2_sb.set_text(pick(is_saved("n2"), "Remove", "Save"))
    ui.r3_sb.set_text(pick(is_saved("n3"), "Remove", "Save"))

    ui.tab_all.set_text(pick(tab == "all", "● All", "All"))
    ui.tab_saved.set_text(pick(tab == "saved", "● Saved", "Saved"))
}

// ---------- shared button styles ----------

let Flat = ButtonFlat{height: 44 padding: Inset{left: 12 right: 12} align: Align{x: 0.5 y: 0.5}
    draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: accent color_hover: accent color_down: accent text_style +: {font_size: 15}}}

let Quiet = ButtonFlat{height: 44 padding: Inset{left: 12 right: 12} align: Align{x: 0.5 y: 0.5}
    draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: ink2 color_hover: ink2 color_down: ink2 text_style +: {font_size: 15}}}

let Seg = ButtonFlat{height: 44 width: Fill align: Align{x: 0.5 y: 0.5}
    draw_bg +: {color: #x00000000 color_hover: #x0000000f color_down: #x0000001a border_size: 0.0}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 14}}}

// ---------- root ----------

SolidView{width: Fill height: Fill flow: Down draw_bg.color: ground

    View{width: Fill height: Fit flow: Down spacing: 2
        padding: Inset{left: 16 right: 16 top: 12 bottom: 8}
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
            Label{text: "News" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 19}}
            View{width: Fill height: 1}
            RoundedView{width: Fit height: Fit
                padding: Inset{left: 8 right: 8 top: 3 bottom: 3}
                draw_bg.color: demo_bg draw_bg.border_radius: 6.0
                Label{text: "DEMO" draw_text.color: demo_ink draw_text.text_style: theme.font_bold{font_size: 11}}
            }
        }
        count := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
    }

    View{width: Fill height: Fill flow: Down

        // ===== L0 =====
        glance := View{width: Fill height: Fill flow: Down spacing: 8
            padding: Inset{left: 16 right: 16 top: 4 bottom: 8}
            g_card := RoundedView{width: Fill height: Fit flow: Down spacing: 3
                padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                draw_bg.color: surface draw_bg.border_radius: 14.0
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    g_outlet := Label{text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                    View{width: Fill height: 1}
                    g_at := Label{text: "" draw_text.color: muted draw_text.text_style.font_size: 11}
                }
                g_title := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                g_brief := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 13}
                g_meta := Label{text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
            }
            View{width: Fill height: 1}
            View{width: Fill height: Fit flow: Right spacing: 8
                Flat{text: "Read" on_click: || do_open(lead_id())}
                Flat{text: "Feed" on_click: || set_depth(2)}
            }
        }

        // ===== L1 =====
        expanded := View{visible: false width: Fill height: Fill flow: Down spacing: 8
            padding: Inset{left: 16 right: 16 top: 4 bottom: 8}
            x_card := RoundedView{width: Fill height: Fit flow: Down spacing: 3
                padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                draw_bg.color: surface draw_bg.border_radius: 14.0
                x_outlet := Label{text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                x_title := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                x_meta := Label{text: "" draw_text.color: muted draw_text.text_style.font_size: 11}
                SolidView{width: Fill height: 1 draw_bg.color: line}
                x_brief := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 13}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                x_action := Flat{text: "Save" on_click: || do_toggle_saved(sel)}
                Flat{text: "Feed" on_click: || set_depth(2)}
            }
            View{width: Fill height: 1}
            View{width: Fill height: Fit flow: Right spacing: 8
                Quiet{text: "‹ Glance" on_click: || set_depth(0)}
            }
        }

        // ===== L2 =====
        full := View{visible: false width: Fill height: Fill
            l2 := ScrollYView{width: Fill height: Fill flow: Down spacing: 8
                padding: Inset{left: 16 right: 16 top: 4 bottom: 8}

                l2_list := View{width: Fill height: Fit flow: Down spacing: 6
                    RoundedView{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6
                        padding: Inset{left: 12 right: 12 top: 4 bottom: 4}
                        draw_bg.color: surface draw_bg.border_radius: 12.0
                        tab_all := Flat{text: "All" on_click: || set_tab("all")}
                        tab_saved := Flat{text: "Saved" on_click: || set_tab("saved")}
                    }
                    r1 := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "Riverside bridge reopens after inspection" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "Harbour Times · 08:20" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r1_b := Flat{text: "Save" on_click: || do_toggle_saved("n1")}
                            Flat{text: "Read" on_click: || do_open("n1")}
                            }
                        }
                    }
                    r2 := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "Library extends weekend hours" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "Harbour Times · 07:55" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r2_b := Flat{text: "Save" on_click: || do_toggle_saved("n2")}
                            Flat{text: "Read" on_click: || do_open("n2")}
                            }
                        }
                    }
                    r3 := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "Docklands solar trial powers first block" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "Field Notes · Yesterday" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r3_b := Flat{text: "Save" on_click: || do_toggle_saved("n3")}
                            Flat{text: "Read" on_click: || do_open("n3")}
                            }
                        }
                    }
                    r1_s := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "Riverside bridge reopens after inspection" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "Harbour Times · 08:20" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r1_sb := Flat{text: "Remove" on_click: || do_toggle_saved("n1")}
                            Flat{text: "Read" on_click: || do_open("n1")}
                            }
                        }
                    }
                    r2_s := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "Library extends weekend hours" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "Harbour Times · 07:55" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r2_sb := Flat{text: "Remove" on_click: || do_toggle_saved("n2")}
                            Flat{text: "Read" on_click: || do_open("n2")}
                            }
                        }
                    }
                    r3_s := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "Docklands solar trial powers first block" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "Field Notes · Yesterday" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r3_sb := Flat{text: "Remove" on_click: || do_toggle_saved("n3")}
                            Flat{text: "Read" on_click: || do_open("n3")}
                            }
                        }
                    }
                    saved_empty := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 3
                        padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                        draw_bg.color: surface draw_bg.border_radius: 14.0
                        Label{width: Fill text: "Nothing saved" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                        Label{width: Fill text: "Save a story from All to read it here." draw_text.color: ink2 draw_text.text_style.font_size: 12}
                    }
                }

                l2_detail := View{visible: false width: Fill height: Fit flow: Down spacing: 6
                    RoundedView{width: Fill height: Fit flow: Down spacing: 3
                        padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                        draw_bg.color: surface draw_bg.border_radius: 14.0
                        rd_outlet := Label{text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 11}}
                        rd_title := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                        rd_meta := Label{text: "" draw_text.color: muted draw_text.text_style.font_size: 11}
                        SolidView{width: Fill height: 1 draw_bg.color: line}
                        rd_body := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 13}
                    }
                    View{width: Fill height: Fit flow: Right spacing: 8
                        rd_action := Flat{text: "Save" on_click: || do_toggle_saved(sel)}
                        Quiet{text: "‹ Feed" on_click: || do_back()}
                    }
                }
            }
        }
    }

    View{width: Fill height: Fit flow: Down spacing: 4
        padding: Inset{left: 16 right: 16 top: 6 bottom: 8}
        SolidView{width: Fill height: 1 draw_bg.color: line}
        RoundedView{width: Fill height: Fit flow: Right spacing: 4
            padding: Inset{left: 4 right: 4 top: 4 bottom: 4}
            draw_bg.color: #xe5e5ea draw_bg.border_radius: 12.0
            b0 := Seg{text: "L0" on_click: || set_depth(0)}
            b1 := Seg{text: "L1" on_click: || set_depth(1)}
            b2 := Seg{text: "L2" on_click: || set_depth(2)}
        }
        status := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
    }
}

fn lead_id(){
    let m = lead()
    if m == nil { return "" }
    m.id
}

fn boot(){
    say("Demo feed")
    sync()
}

start_timeout(0.05, || boot())
