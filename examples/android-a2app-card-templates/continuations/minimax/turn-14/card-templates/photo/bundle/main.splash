// Photo card template — dev.studio.cards.photo
// All records are SYNTHETIC DEMO DATA in this app's local list. This offline
// Studio cannot load image assets, so no picture is ever shown: each row states
// plainly that the photo is not loaded here, and no control pretends otherwise.
//
// Depths are PRESENTATION depths (UI), not parser levels:
//   L0  lead photo at a glance
//   L1  expanded record with a reversible Favorite
//   L2  list (All / Favorites) -> record detail

let photos = [
    {id: "p1" title: "Mill Street at first light" date: "17 Sep" place: "Riverside"
        people: "Alex, Sofia" moment: "September snapshots"
        note: "Long exposure from the north bank, taken before the bridge opened to traffic. Demo record."}
    {id: "p2" title: "Reading room, west window" date: "15 Sep" place: "Central Library"
        people: "Noah, Lily" moment: "Everyday moments"
        note: "Saturday morning reading hour. Demo record."}
    {id: "p3" title: "Harbour cranes at dusk" date: "12 Sep" place: "Docklands"
        people: "James" moment: "September snapshots"
        note: "Shot from the north quay as the yard lights came on. Demo record."}
]

let ground = #xf2f2f7
let surface = #xffffff
let ink = #x1c1c1e
let ink2 = #x3c3c43
let muted = #x8e8e93
let accent = #x007aff
let line = #xe5e5ea
let demo_bg = #xfff3cd
let demo_ink = #x8a0b00

let fav = []
let status = "Demo album."
let depth = 0
let sel = "p1"
let route = "list"
let tab = "all"

// ---------- state helpers ----------

fn pick(cond, on, off){ if cond { on } else { off } }

fn ph_of(id){
    for p in photos { if p.id == id { return p } }
    nil
}

fn is_fav(id){
    for f in fav { if f == id { return true } }
    false
}

fn n_fav(){ fav.len() }

fn lead(){
    for p in photos { return p }
    nil
}

// L0 always shows the first record, so its action must target that record
// rather than whatever a previous route left selected.
fn lead_id(){
    let m = lead()
    if m == nil { return "" }
    m.id
}

fn say(s){ status = s; ui.status.set_text(status) }

fn depth_name(){
    if depth == 0 { return "L0 Glance" }
    if depth == 1 { return "L1 Photo" }
    if route == "detail" { return "L2 Photo" }
    return "L2 Album"
}

fn set_depth(d){
    depth = d
    route = "list"
    say("Showing " + depth_name())
    sync()
}

fn do_open(id){
    sel = id
    route = "detail"
    set_depth(2)
    route = "detail"
    say("Showing " + depth_name())
    sync()
}

fn do_back(){
    route = "list"
    say("Showing " + depth_name())
    sync()
}

fn do_fav(id){
    if is_fav(id) { return }
    fav.push(id)
    let p = ph_of(id)
    if p == nil { return }
    say("Favorited " + p.title)
    sync()
}

fn do_unfav(id){
    if !is_fav(id) { return }
    fav.retain(|x| x != id)
    let p = ph_of(id)
    if p == nil { return }
    say("Removed from Favorites")
    sync()
}

// The dynamically labelled button must do what its label currently says, so one
// action serves both directions and is reversible wherever it appears.
fn do_toggle_fav(id){
    if is_fav(id) { do_unfav(id) } else { do_fav(id) }
}

fn set_tab(t){
    tab = t
    say("Showing " + pick(t == "all", "All photos", "Favorites"))
    sync()
}

// ---------- chrome sync ----------

fn sync(){
    ui.glance.set_visible(depth == 0)
    ui.expanded.set_visible(depth == 1)
    ui.full.set_visible(depth == 2)

    ui.count.set_text("" + photos.len() + " photos · " + "" + n_fav() + " favorites")
    ui.status.set_text(status)
    ui.b0.set_text(pick(depth == 0, "● L0", "L0"))
    ui.b1.set_text(pick(depth == 1, "● L1", "L1"))
    ui.b2.set_text(pick(depth == 2, "● L2", "L2"))

    let m = lead()
    ui.g_title.set_text(m.title)
    ui.g_date.set_text(m.date)
    ui.g_place.set_text(m.place)
    ui.g_people.set_text(m.people)

    let s = ph_of(sel)
    ui.x_title.set_text(s.title)
    ui.x_date.set_text(s.date)
    ui.x_place.set_text(s.place)
    ui.x_people.set_text(s.people)
    ui.x_note.set_text(s.note)
    ui.x_action.set_text(pick(is_fav(s.id), "Remove from Favorites", "Favorite"))

    ui.rd_title.set_text(s.title)
    ui.rd_date.set_text(s.date)
    ui.rd_place.set_text(s.place)
    ui.rd_people.set_text(s.people)
    ui.rd_note.set_text(s.note)
    ui.rd_action.set_text(pick(is_fav(s.id), "Remove from Favorites", "Favorite"))

    ui.l2_list.set_visible(route == "list")
    ui.l2_detail.set_visible(route == "detail")

    ui.r1.set_visible(tab == "all")
    ui.r2.set_visible(tab == "all")
    ui.r3.set_visible(tab == "all")
    ui.r1_f.set_visible(tab == "fav" && is_fav("p1"))
    ui.r2_f.set_visible(tab == "fav" && is_fav("p2"))
    ui.r3_f.set_visible(tab == "fav" && is_fav("p3"))
    ui.fav_empty.set_visible(tab == "fav" && n_fav() == 0)

    ui.r1_b.set_text(pick(is_fav("p1"), "Remove", "Favorite"))
    ui.r2_b.set_text(pick(is_fav("p2"), "Remove", "Favorite"))
    ui.r3_b.set_text(pick(is_fav("p3"), "Remove", "Favorite"))
    ui.r1_fb.set_text(pick(is_fav("p1"), "Remove", "Favorite"))
    ui.r2_fb.set_text(pick(is_fav("p2"), "Remove", "Favorite"))
    ui.r3_fb.set_text(pick(is_fav("p3"), "Remove", "Favorite"))

    ui.tab_all.set_text(pick(tab == "all", "● All", "All"))
    ui.tab_fav.set_text(pick(tab == "fav", "● Favorites", "Favorites"))
}

// ---------- shared button styles ----------

let Flat = ButtonFlat{height: 44 padding: Inset{left: 12 right: 12} align: Align{x: 0.5 y: 0.5}
    draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: accent color_hover: accent color_down: accent text_style +: {font_size: 15}}}

let Quiet = ButtonFlat{height: 44 padding: Inset{left: 12 right: 12} align: Align{x: 0.5 y: 0.5}
    draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: ink2 color_hover: ink2 color_down: ink2 text_style +: {font_size: 15}}}

let Seg = ButtonFlat{height: 44 width: Fill align: Align{x: 0.5 y: 0.5}
    draw_bg +: {color: #x00000000 color_hover: #x0000000f color_down: #x0000001a border_size: 0.0}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 14}}}

// ---------- root ----------

SolidView{width: Fill height: Fill flow: Down draw_bg.color: ground

    View{width: Fill height: Fit flow: Down spacing: 2
        padding: Inset{left: 16 right: 16 top: 12 bottom: 8}
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
            Label{text: "Photo" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 19}}
            View{width: Fill height: 1}
            RoundedView{width: Fit height: Fit
                padding: Inset{left: 8 right: 8 top: 3 bottom: 3}
                draw_bg.color: demo_bg draw_bg.border_radius: 6.0
                Label{text: "DEMO" draw_text.color: demo_ink draw_text.text_style: theme.font_bold{font_size: 11}}
            }
        }
        count := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
    }

    View{width: Fill height: Fill flow: Down

        // ===== L0 =====
        glance := View{width: Fill height: Fill flow: Down spacing: 8
            padding: Inset{left: 16 right: 16 top: 4 bottom: 8}
            g_card := RoundedView{width: Fill height: Fit flow: Down spacing: 3
                padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                draw_bg.color: surface draw_bg.border_radius: 14.0
                Label{text: "PHOTO NOT LOADED OFFLINE" draw_text.color: muted draw_text.text_style.font_size: 11}
                g_title := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    g_date := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 12}
                    g_place := Label{text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
                }
                g_people := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                Flat{text: "Open" on_click: || do_open(lead_id())}
                Flat{text: "Album" on_click: || set_depth(2)}
            }
        }

        // ===== L1 =====
        expanded := View{visible: false width: Fill height: Fill flow: Down spacing: 8
            padding: Inset{left: 16 right: 16 top: 4 bottom: 8}
            x_card := RoundedView{width: Fill height: Fit flow: Down spacing: 3
                padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                draw_bg.color: surface draw_bg.border_radius: 14.0
                Label{text: "PHOTO NOT LOADED OFFLINE" draw_text.color: muted draw_text.text_style.font_size: 11}
                x_title := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    x_date := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 12}
                    x_place := Label{text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
                }
                x_people := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
                SolidView{width: Fill height: 1 draw_bg.color: line}
                x_note := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 13}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                x_action := Flat{text: "Favorite" on_click: || do_toggle_fav(sel)}
                Flat{text: "Album" on_click: || set_depth(2)}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                Quiet{text: "‹ Glance" on_click: || set_depth(0)}
            }
        }

        // ===== L2 =====
        full := View{visible: false width: Fill height: Fill
            l2 := ScrollYView{width: Fill height: Fill flow: Down spacing: 8
                padding: Inset{left: 16 right: 16 top: 4 bottom: 8}

                l2_list := View{width: Fill height: Fit flow: Down spacing: 6
                    RoundedView{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6
                        padding: Inset{left: 12 right: 12 top: 4 bottom: 4}
                        draw_bg.color: surface draw_bg.border_radius: 12.0
                        tab_all := Flat{text: "All" on_click: || set_tab("all")}
                        tab_fav := Flat{text: "Favorites" on_click: || set_tab("fav")}
                    }
                    r1 := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "Mill Street at first light" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "17 Sep · Riverside" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r1_b := Flat{text: "Favorite" on_click: || do_toggle_fav("p1")}
                            Flat{text: "Open" on_click: || do_open("p1")}
                            }
                        }
                    }
                    r2 := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "Reading room, west window" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "15 Sep · Central Library" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r2_b := Flat{text: "Favorite" on_click: || do_toggle_fav("p2")}
                            Flat{text: "Open" on_click: || do_open("p2")}
                            }
                        }
                    }
                    r3 := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "Harbour cranes at dusk" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "12 Sep · Docklands" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r3_b := Flat{text: "Favorite" on_click: || do_toggle_fav("p3")}
                            Flat{text: "Open" on_click: || do_open("p3")}
                            }
                        }
                    }
                    r1_f := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "Mill Street at first light" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "17 Sep · Riverside" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r1_fb := Flat{text: "Remove" on_click: || do_toggle_fav("p1")}
                            Flat{text: "Open" on_click: || do_open("p1")}
                            }
                        }
                    }
                    r2_f := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "Reading room, west window" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "15 Sep · Central Library" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r2_fb := Flat{text: "Remove" on_click: || do_toggle_fav("p2")}
                            Flat{text: "Open" on_click: || do_open("p2")}
                            }
                        }
                    }
                    r3_f := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "Harbour cranes at dusk" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "12 Sep · Docklands" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r3_fb := Flat{text: "Remove" on_click: || do_toggle_fav("p3")}
                            Flat{text: "Open" on_click: || do_open("p3")}
                            }
                        }
                    }
                    fav_empty := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 3
                        padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                        draw_bg.color: surface draw_bg.border_radius: 14.0
                        Label{width: Fill text: "No favorites yet" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                        Label{width: Fill text: "Favorite a photo from All to see it here." draw_text.color: ink2 draw_text.text_style.font_size: 12}
                    }
                }

                l2_detail := View{visible: false width: Fill height: Fit flow: Down spacing: 6
                    RoundedView{width: Fill height: Fit flow: Down spacing: 3
                        padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                        draw_bg.color: surface draw_bg.border_radius: 14.0
                        Label{text: "PHOTO NOT LOADED OFFLINE" draw_text.color: muted draw_text.text_style.font_size: 11}
                        rd_title := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                            rd_date := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 12}
                            rd_place := Label{text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
                        }
                        rd_people := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
                        SolidView{width: Fill height: 1 draw_bg.color: line}
                        rd_note := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 13}
                    }
                    View{width: Fill height: Fit flow: Right spacing: 8
                        rd_action := Flat{text: "Favorite" on_click: || do_toggle_fav(sel)}
                        Quiet{text: "‹ Album" on_click: || do_back()}
                    }
                }
            }
        }
    }

    View{width: Fill height: Fit flow: Down spacing: 4
        padding: Inset{left: 16 right: 16 top: 6 bottom: 8}
        SolidView{width: Fill height: 1 draw_bg.color: line}
        RoundedView{width: Fill height: Fit flow: Right spacing: 4
            padding: Inset{left: 4 right: 4 top: 4 bottom: 4}
            draw_bg.color: #xe5e5ea draw_bg.border_radius: 12.0
            b0 := Seg{text: "L0" on_click: || set_depth(0)}
            b1 := Seg{text: "L1" on_click: || set_depth(1)}
            b2 := Seg{text: "L2" on_click: || set_depth(2)}
        }
        status := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
    }
}

fn boot(){
    say("Demo album")
    sync()
}

start_timeout(0.05, || boot())
