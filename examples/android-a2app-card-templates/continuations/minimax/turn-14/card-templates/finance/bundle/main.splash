// Finance card template — dev.studio.cards.finance
// All instruments are SYNTHETIC DEMO DATA in this app's local list. No market
// data is fetched, no quote is live, and no trade can be placed. Price and
// change are fixed demo values and never update while the app is open.
//
// Depths are PRESENTATION depths (UI), not parser levels:
//   L0  watchlist lead at a glance
//   L1  expanded instrument with a reversible Watch
//   L2  list (All / Watching) -> instrument detail

let items = [
    {id: "f1" sym: "HRB" name: "Harbour Rail" price: "42.18" change: "+1.24" dir: "up" as_of: "08:45"
        brief: "Regional rail operator, demo record."
        body: "Harbour Rail operates the coastal regional line. This demo record shows a fictional instrument used to exercise the card layouts: the price, the change and the as-of time are fixed sample values, not a live quote. No trade can be placed from this card."}
    {id: "f2" sym: "DLK" name: "Delta Logistics" price: "17.62" change: "-0.38" dir: "down" as_of: "08:45"
        brief: "Freight and warehousing group, demo record."
        body: "Delta Logistics handles port freight and warehousing. This demo record shows a fictional instrument: price, change and as-of time are fixed sample values, never a live quote, and there is no way to buy or sell from here."}
    {id: "f3" sym: "SGE" name: "Sage Energy" price: "9.94" change: "+0.07" dir: "up" as_of: "08:45"
        brief: "Utility with a solar trial, demo record."
        body: "Sage Energy is a regional utility trialling shared rooftop solar. This demo record shows a fictional instrument: the price, change and as-of time are fixed sample values rather than a live quote, and nothing here can be traded."}
]

let ground = #xf2f2f7
let surface = #xffffff
let ink = #x1c1c1e
let ink2 = #x3c3c43
let muted = #x8e8e93
let accent = #x007aff
let up = #x248a3d
let down = #xd70015
let line = #xe5e5ea
let demo_bg = #xfff3cd
let demo_ink = #x8a0b00

let watching = []
let status = "Demo watchlist."
let depth = 0
let sel = "f1"
let route = "list"
let tab = "all"

// ---------- state helpers ----------

fn pick(cond, on, off){ if cond { on } else { off } }

fn it_of(id){
    for i in items { if i.id == id { return i } }
    nil
}

fn is_watched(id){
    for w in watching { if w == id { return true } }
    false
}

fn n_watching(){ watching.len() }

fn say(s){ status = s; ui.status.set_text(s) }

fn depth_name(){
    if depth == 0 { return "L0 Glance" }
    if depth == 1 { return "L1 Card" }
    if route == "detail" { return "L2 Card" }
    return "L2 List"
}

fn set_depth(d){
    depth = d
    route = "list"
    say("")
    sync()
}

fn do_open(id){
    sel = id
    route = "detail"
    set_depth(2)
    route = "detail"
    sync()
}

fn do_back(){
    route = "list"
    say("")
    sync()
}

fn do_watch(id){
    if is_watched(id) { return }
    watching.push(id)
    let i = it_of(id)
    if i == nil { return }
    say("Watching " + i.sym)
    sync()
}

fn do_unwatch(id){
    if !is_watched(id) { return }
    watching.retain(|x| x != id)
    let i = it_of(id)
    if i == nil { return }
    say("Removed from Watching")
    sync()
}

// The dynamically labelled button must do what its current label says, so one
// action serves both directions and stays reversible in L1 and in detail.
fn do_toggle_watch(id){
    if is_watched(id) { do_unwatch(id) } else { do_watch(id) }
}

// L0 always shows items[0], so its Open must target that item rather than
// whatever a previous visit left selected.
fn lead_id(){ return "f1" }

fn set_tab(t){
    tab = t
    say("")
    sync()
}

// ---------- chrome sync ----------

fn sync(){
    ui.glance.set_visible(depth == 0)
    ui.expanded.set_visible(depth == 1)
    ui.full.set_visible(depth == 2)

    ui.count.set_text("" + items.len() + " instruments · " + "" + n_watching() + " watched")
    ui.status.set_text(status)
    ui.b0.set_text(pick(depth == 0, "● L0", "L0"))
    ui.b1.set_text(pick(depth == 1, "● L1", "L1"))
    ui.b2.set_text(pick(depth == 2, "● L2", "L2"))

    let m = items[0]
    ui.g_sym.set_text(m.sym)
    ui.g_price.set_text(m.price)
    ui.g_change.set_text(m.change)
    // sign and colour agree: a down change never wears the positive colour.
    // Only set_text / set_visible are used — no colour setter exists.
    ui.g_dir.set_text(pick(m.dir == "up", "▲", "▼"))
    ui.g_change.set_text(m.change)
    ui.g_change_dn.set_text(m.change)
    ui.g_change.set_visible(m.dir == "up")
    ui.g_change_dn.set_visible(m.dir != "up")
    ui.g_name.set_text(m.name)
    ui.g_brief.set_text(m.brief)
    ui.g_asof.set_text("as of " + m.as_of + " · demo")

    let s = it_of(sel)
    ui.x_sym.set_text(s.sym + " · " + s.name)
    ui.x_price.set_text(s.price)
    ui.x_change.set_text(s.change)
    ui.x_change_dn.set_text(s.change)
    ui.x_change.set_visible(s.dir == "up")
    ui.x_change_dn.set_visible(s.dir != "up")
    ui.x_brief.set_text(s.brief)
    ui.x_asof.set_text("as of " + s.as_of + " · demo, not a live quote")
    ui.x_action.set_text(pick(is_watched(s.id), "Remove", "Watch"))

    ui.rd_sym.set_text(s.sym + " · " + s.name)
    ui.rd_price.set_text(s.price)
    ui.rd_change.set_text(s.change)
    ui.rd_change_dn.set_text(s.change)
    ui.rd_change.set_visible(s.dir == "up")
    ui.rd_change_dn.set_visible(s.dir != "up")
    ui.rd_asof.set_text("as of " + s.as_of + " · demo, not a live quote")
    ui.rd_body.set_text(s.body)
    ui.rd_action.set_text(pick(is_watched(s.id), "Remove from Watching", "Watch"))

    ui.l2_list.set_visible(route == "list")
    ui.l2_detail.set_visible(route == "detail")

    ui.r1.set_visible(tab == "all")
    ui.r2.set_visible(tab == "all")
    ui.r3.set_visible(tab == "all")
    ui.r1_w.set_visible(tab == "watch" && is_watched("f1"))
    ui.r2_w.set_visible(tab == "watch" && is_watched("f2"))
    ui.r3_w.set_visible(tab == "watch" && is_watched("f3"))
    ui.watch_empty.set_visible(tab == "watch" && n_watching() == 0)

    ui.r1_b.set_text(pick(is_watched("f1"), "Watching", "Watch"))
    ui.r2_b.set_text(pick(is_watched("f2"), "Watching", "Watch"))
    ui.r3_b.set_text(pick(is_watched("f3"), "Watching", "Watch"))
    ui.r1_wb.set_text(pick(is_watched("f1"), "Remove", "Watch"))
    ui.r2_wb.set_text(pick(is_watched("f2"), "Remove", "Watch"))
    ui.r3_wb.set_text(pick(is_watched("f3"), "Remove", "Watch"))

    ui.tab_all.set_text(pick(tab == "all", "● All", "All"))
    ui.tab_watch.set_text(pick(tab == "watch", "● Watching", "Watching"))
}

// ---------- shared button styles ----------

let Flat = ButtonFlat{height: 44 padding: Inset{left: 12 right: 12} align: Align{x: 0.5 y: 0.5}
    draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: accent color_hover: accent color_down: accent text_style +: {font_size: 15}}}

let Quiet = ButtonFlat{height: 44 padding: Inset{left: 12 right: 12} align: Align{x: 0.5 y: 0.5}
    draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: ink2 color_hover: ink2 color_down: ink2 text_style +: {font_size: 15}}}

let Seg = ButtonFlat{height: 44 width: Fill align: Align{x: 0.5 y: 0.5}
    draw_bg +: {color: #x00000000 color_hover: #x0000000f color_down: #x0000001a border_size: 0.0}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 14}}}

// ---------- root ----------

SolidView{width: Fill height: Fill flow: Down draw_bg.color: ground

    View{width: Fill height: Fit flow: Down spacing: 2
        padding: Inset{left: 16 right: 16 top: 12 bottom: 8}
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
            Label{text: "Finance" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 19}}
            View{width: Fill height: 1}
            RoundedView{width: Fit height: Fit
                padding: Inset{left: 8 right: 8 top: 3 bottom: 3}
                draw_bg.color: demo_bg draw_bg.border_radius: 6.0
                Label{text: "DEMO" draw_text.color: demo_ink draw_text.text_style: theme.font_bold{font_size: 11}}
            }
        }
        count := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
    }

    View{width: Fill height: Fill flow: Down

        // ===== L0 =====
        glance := View{width: Fill height: Fill flow: Down spacing: 8
            padding: Inset{left: 16 right: 16 top: 4 bottom: 8}
            g_card := RoundedView{width: Fill height: Fit flow: Down spacing: 3
                padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                draw_bg.color: surface draw_bg.border_radius: 14.0
                g_sym := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    g_price := Label{text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                    g_dir := Label{text: "▲" draw_text.color: up draw_text.text_style.font_size: 12}
                    g_change := Label{text: "" draw_text.color: up draw_text.text_style: theme.font_bold{font_size: 13}}
                    g_change_dn := Label{text: "" draw_text.color: down draw_text.text_style: theme.font_bold{font_size: 13}}
                }
                g_name := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 13}
                g_brief := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 12}
                g_asof := Label{text: "" draw_text.color: muted draw_text.text_style.font_size: 11}
            }
            View{width: Fill height: 1}
            View{width: Fill height: Fit flow: Right spacing: 8
                Flat{text: "Open" on_click: || do_open(lead_id())}
                Flat{text: "List" on_click: || set_depth(2)}
            }
        }

        // ===== L1 =====
        expanded := View{visible: false width: Fill height: Fill flow: Down spacing: 8
            padding: Inset{left: 16 right: 16 top: 4 bottom: 8}
            x_card := RoundedView{width: Fill height: Fit flow: Down spacing: 3
                padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                draw_bg.color: surface draw_bg.border_radius: 14.0
                x_sym := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    x_price := Label{text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                    x_change := Label{text: "" draw_text.color: up draw_text.text_style: theme.font_bold{font_size: 13}}
                    x_change_dn := Label{text: "" draw_text.color: down draw_text.text_style: theme.font_bold{font_size: 13}}
                }
                x_brief := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 13}
                x_asof := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 11}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                x_action := Flat{text: "Watch" on_click: || do_toggle_watch(sel)}
                Quiet{text: "Open" on_click: || do_open(sel)}
            }
            View{width: Fill height: 1}
            View{width: Fill height: Fit flow: Right spacing: 8
                Flat{text: "List" on_click: || set_depth(2)}
                Quiet{text: "‹ Glance" on_click: || set_depth(0)}
            }
        }

        // ===== L2 =====
        full := View{visible: false width: Fill height: Fill
            l2 := ScrollYView{width: Fill height: Fill flow: Down spacing: 8
                padding: Inset{left: 16 right: 16 top: 4 bottom: 8}

                RoundedView{width: Fill height: Fit flow: Right spacing: 4
                    padding: Inset{left: 4 right: 4 top: 4 bottom: 4}
                    draw_bg.color: #xe5e5ea draw_bg.border_radius: 12.0
                    tab_all := Seg{text: "All" on_click: || set_tab("all")}
                    tab_watch := Seg{text: "Watching" on_click: || set_tab("watch")}
                }

                l2_list := View{width: Fill height: Fit flow: Down spacing: 6
                    r1 := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "HRB · Harbour Rail" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "42.18  +1.24" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r1_b := Flat{text: "Watch" on_click: || do_toggle_watch("f1")}
                            Flat{text: "Open" on_click: || do_open("f1")}
                            }
                        }
                    }
                    r1_w := View{visible: false width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "HRB · Harbour Rail" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "42.18  +1.24" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r1_wb := Flat{text: "Remove" on_click: || do_toggle_watch("f1")}
                            Flat{text: "Open" on_click: || do_open("f1")}
                            }
                        }
                    }
                    r2 := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "DLK · Delta Logistics" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "17.62  -0.38" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r2_b := Flat{text: "Watch" on_click: || do_toggle_watch("f2")}
                            Flat{text: "Open" on_click: || do_open("f2")}
                            }
                        }
                    }
                    r2_w := View{visible: false width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "DLK · Delta Logistics" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "17.62  -0.38" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r2_wb := Flat{text: "Remove" on_click: || do_toggle_watch("f2")}
                            Flat{text: "Open" on_click: || do_open("f2")}
                            }
                        }
                    }
                    r3 := View{width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "SGE · Sage Energy" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "9.94  +0.07" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r3_b := Flat{text: "Watch" on_click: || do_toggle_watch("f3")}
                            Flat{text: "Open" on_click: || do_open("f3")}
                            }
                        }
                    }
                    r3_w := View{visible: false width: Fill height: Fit
                        RoundedView{width: Fill height: Fit flow: Down spacing: 2
                            padding: Inset{left: 14 right: 8 top: 2 bottom: 2}
                            draw_bg.color: surface draw_bg.border_radius: 10.0
                            Label{width: Fill text: "SGE · Sage Energy" draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: "9.94  +0.07" draw_text.color: muted draw_text.text_style.font_size: 11}
                            View{width: Fill height: Fit flow: Right spacing: 8
                            r3_wb := Flat{text: "Remove" on_click: || do_toggle_watch("f3")}
                            Flat{text: "Open" on_click: || do_open("f3")}
                            }
                        }
                    }
                    watch_empty := RoundedView{visible: false width: Fill height: Fit flow: Down spacing: 3
                        padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                        draw_bg.color: surface draw_bg.border_radius: 14.0
                        Label{width: Fill text: "Not watching anything" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                        Label{width: Fill text: "Watch an instrument from All to see it here." draw_text.color: ink2 draw_text.text_style.font_size: 12}
                    }
                }

                l2_detail := View{visible: false width: Fill height: Fit flow: Down spacing: 6
                    RoundedView{width: Fill height: Fit flow: Down spacing: 3
                        padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                        draw_bg.color: surface draw_bg.border_radius: 14.0
                        rd_sym := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                            rd_price := Label{text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                            rd_change := Label{text: "" draw_text.color: up draw_text.text_style: theme.font_bold{font_size: 13}}
                            rd_change_dn := Label{text: "" draw_text.color: down draw_text.text_style: theme.font_bold{font_size: 13}}
                        }
                        rd_asof := Label{width: Fill text: "" draw_text.color: muted draw_text.text_style.font_size: 11}
                        SolidView{width: Fill height: 1 draw_bg.color: line}
                        rd_body := Label{width: Fill text: "" draw_text.color: ink2 draw_text.text_style.font_size: 13}
                    }
                    View{width: Fill height: Fit flow: Right spacing: 8
                        rd_action := Flat{text: "Watch" on_click: || do_toggle_watch(sel)}
                        Quiet{text: "‹ List" on_click: || do_back()}
                    }
                }
            }
        }
    }

    View{width: Fill height: Fit flow: Down spacing: 4
        padding: Inset{left: 16 right: 16 top: 6 bottom: 8}
        SolidView{width: Fill height: 1 draw_bg.color: line}
        RoundedView{width: Fill height: Fit flow: Right spacing: 4
            padding: Inset{left: 4 right: 4 top: 4 bottom: 4}
            draw_bg.color: #xe5e5ea draw_bg.border_radius: 12.0
            b0 := Seg{text: "L0" on_click: || set_depth(0)}
            b1 := Seg{text: "L1" on_click: || set_depth(1)}
            b2 := Seg{text: "L2" on_click: || set_depth(2)}
        }
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
            status := Label{text: "" draw_text.color: muted draw_text.text_style.font_size: 12}
            View{width: Fill height: 1}
        }
    }
}

fn boot(){
    say("Showing L0 Glance")
    sync()
}

start_timeout(0.05, || boot())
