// Mail Cards — native interactive preview of the MAIL card template.
// Presentation depths: L0 compact glance / L1 expanded / L2 full app.
// Synthetic demo content only. No mailbox access, no network, no mail sent.
//
// Layout intent: navigation + status are pinned at the TOP so they stay
// reachable even when the Android keyboard shrinks the viewport; the card sits
// in a Fill ScrollYView below and scrolls. All active tap targets >= 44 logical px.

let depth = "glance"
let view_state = "ready"
let show_states = false
let archived = false
let folder = "inbox"
let detail_open = false
let open_id = ""
let reply_text = ""
let sent_demo = false
let msg_note = ""

// ---- review chrome (gallery controls; NOT part of the reusable glance) ----
let NavBtn = ButtonFlat{height: 44 padding: 10 draw_bg +: {color: #xe8edf3 color_hover: #xdde5ef color_down: #xd0dae7} draw_text +: {color: #x1c2430 color_hover: #x1c2430 color_down: #x1c2430}}
let AccentBtn = ButtonFlat{height: 44 padding: 12 draw_bg +: {color: #x2f6fed color_hover: #x3d7cf0 color_down: #x275fd0} draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
let GhostBtn = ButtonFlat{height: 44 padding: 12 draw_bg +: {color: #xffffff color_hover: #xf0f4f8 color_down: #xe6ecf3} draw_text +: {color: #x1c2430 color_hover: #x1c2430 color_down: #x1c2430}}
let OpenBtn = ButtonFlat{height: 44 width: 108 padding: 8 draw_bg +: {color: #xe8edf3 color_hover: #xdde5ef color_down: #xd0dae7} draw_text +: {color: #x1c2430 color_hover: #x1c2430 color_down: #x1c2430}}

fn depth_name(){
    if depth == "glance" { return "L0 glance" }
    if depth == "expand" { return "L1 expanded" }
    return "L2 app"
}
fn title_of(id){
    if id == "ana" { return "Contract signing — Friday?" }
    if id == "digest" { return "Your Thursday digest is ready" }
    return "Quarterly report draft"
}
fn sender_of(id){
    if id == "ana" { return "Ana Rivera · ana@acme.demo" }
    if id == "digest" { return "Design Weekly · digest@demo.weekly" }
    return "Finance team · ops@acme.demo"
}
fn body_of(id){
    if id == "ana" { return "Can we sign by Friday? I've attached the revised payment terms for review." }
    if id == "digest" { return "Five short reads on card UI, motion and type. No tracking, just a weekly list." }
    return "Draft numbers for review before Monday's sync."
}

fn refresh_nav(){
    let s = "Mail Cards   ·   " + depth_name() + "   ·   " + view_state
    if archived { s = s + "   ·   mail: archived" }
    ui.depth_status.set_text(s)
    if depth == "glance" { ui.d_gl.set_text("• Glance") } else { ui.d_gl.set_text("Glance") }
    if depth == "expand" { ui.d_ex.set_text("• Expand") } else { ui.d_ex.set_text("Expand") }
    if depth == "app" { ui.d_ap.set_text("• Open app") } else { ui.d_ap.set_text("Open app") }
}
fn toggle_states(){
    if show_states { show_states = false } else { show_states = true }
    if show_states { ui.states_btn.set_text("States ▾") } else { ui.states_btn.set_text("States ▸") }
    ui.states_row.set_visible(show_states)
}

fn set_depth(d){ depth = d detail_open = false sent_demo = false msg_note = "" refresh_nav() ui.stage.render() }
fn set_state(s){ view_state = s refresh_nav() ui.stage.render() }
fn do_archive(){ archived = true refresh_nav() ui.stage.render() }
fn do_undo(){ archived = false sent_demo = false msg_note = "" refresh_nav() ui.stage.render() }
fn set_folder(f){ folder = f detail_open = false refresh_nav() ui.stage.render() }
fn open_detail(id){ open_id = id detail_open = true ui.stage.render() }
fn close_detail(){ detail_open = false ui.stage.render() }
fn on_field(t){ reply_text = t }

fn do_send(){
    if reply_text.trim().len() == 0 {
        sent_demo = false
        msg_note = "Write a reply first — nothing was sent."
    } else {
        sent_demo = true
        msg_note = "Draft queued (local demo) — no real mail was sent."
    }
    ui.stage.render()
}

fn boot(){ refresh_nav() ui.states_row.set_visible(false) ui.stage.render() }

start_timeout(0.05, || boot())

SolidView{width: Fill height: Fill flow: Down padding: 12 spacing: 8 draw_bg.color: #xf4f6f8
    depth_status := Label{width: Fill height: Fit text: "Mail Cards   ·   L0 glance   ·   ready" draw_text.color: #x5b6672 draw_text.text_style.font_size: 12 draw_text.wrap: true}
    View{width: Fill height: Fit flow: Right spacing: 8
        d_gl := NavBtn{text: "• Glance" on_click: || set_depth("glance")}
        d_ex := NavBtn{text: "Expand" on_click: || set_depth("expand")}
        d_ap := NavBtn{text: "Open app" on_click: || set_depth("app")}
        View{width: Fill height: Fit}
        states_btn := NavBtn{text: "States ▸" on_click: || toggle_states()}
    }
    states_row := View{width: Fill height: Fit flow: Right spacing: 8
        NavBtn{text: "Ready" on_click: || set_state("ready")}
        NavBtn{text: "Loading" on_click: || set_state("loading")}
        NavBtn{text: "Empty" on_click: || set_state("empty")}
        NavBtn{text: "Error" on_click: || set_state("error")}
    }

    ScrollYView{width: Fill height: Fill flow: Down spacing: 8
        stage := RoundedView{width: Fill height: Fit flow: Down padding: 14 spacing: 8 draw_bg.color: #xffffff draw_bg.radius: 16 on_render: || {

            // ---------- L0 · compact glance ----------
            if depth == "glance" {
                View{width: Fill height: Fit flow: Right spacing: 8
                    Label{text: "MAIL" draw_text.color: #x2f6fed draw_text.text_style.font_size: 12}
                    View{width: Fill height: Fit}
                    Label{text: "9:41" draw_text.color: #x9aa4b0 draw_text.text_style.font_size: 12}
                }
                if view_state == "loading" { Label{text: "Loading…" draw_text.color: #x9aa4b0 draw_text.text_style.font_size: 15} }
                if view_state == "empty" { Label{text: "No messages" draw_text.color: #x5b6672 draw_text.text_style.font_size: 15} }
                if view_state == "error" { Label{width: Fill height: Fit text: "Couldn't load mail — demo error state" draw_text.color: #xd6342b draw_text.text_style.font_size: 14 draw_text.wrap: true} }
                if view_state == "ready" {
                    Label{text: "Ana Rivera" draw_text.color: #x5b6672 draw_text.text_style.font_size: 13}
                    Label{width: Fill height: Fit text: "Contract signing — Friday?" draw_text.color: #x1c2430 draw_text.text_style.font_size: 18 draw_text.wrap: true}
                    Label{width: Fill height: Fit text: "Can we sign by Friday? Revised terms attached." draw_text.color: #x5b6672 draw_text.text_style.font_size: 13 draw_text.wrap: true}
                    if archived { Label{text: "Archived (demo)" draw_text.color: #x2f6fed draw_text.text_style.font_size: 12} }
                    View{width: Fill height: Fit flow: Right spacing: 8
                        AccentBtn{text: "Reply" on_click: || set_depth("expand")}
                    }
                }
            }

            // ---------- L1 · expanded actionable ----------
            if depth == "expand" {
                View{width: Fill height: Fit flow: Right spacing: 8
                    Label{text: "MAIL" draw_text.color: #x2f6fed draw_text.text_style.font_size: 11}
                    View{width: Fill height: Fit}
                    Label{text: "9:41" draw_text.color: #x9aa4b0 draw_text.text_style.font_size: 12}
                }
                if view_state == "loading" { Label{text: "Loading…" draw_text.color: #x9aa4b0 draw_text.text_style.font_size: 15} }
                if view_state == "empty" { Label{text: "No messages" draw_text.color: #x5b6672 draw_text.text_style.font_size: 15} }
                if view_state == "error" { Label{width: Fill height: Fit text: "Couldn't load mail — demo error state" draw_text.color: #xd6342b draw_text.text_style.font_size: 14 draw_text.wrap: true} }
                if view_state == "ready" {
                    Label{width: Fill height: Fit text: "Contract signing — Friday?" draw_text.color: #x1c2430 draw_text.text_style.font_size: 18 draw_text.wrap: true}
                    Label{text: "Ana Rivera · ana@acme.demo" draw_text.color: #x5b6672 draw_text.text_style.font_size: 12}
                    SolidView{width: Fill height: 1 draw_bg.color: #xe2e7ec}
                    Label{text: "SUMMARY (demo)" draw_text.color: #x9aa4b0 draw_text.text_style.font_size: 11}
                    Label{width: Fill height: Fit text: "Ana attached the revised payment terms and would like to sign by Friday." draw_text.color: #x1c2430 draw_text.text_style.font_size: 14 draw_text.wrap: true}
                    reply_field := TextInput{width: Fill height: 44 padding: 10 text: reply_text empty_text: "Draft a reply…" draw_bg.color: #xf7f9fb draw_bg.radius: 12 draw_text.color: #x1c2430 on_change: |t| on_field(t)}
                    View{width: Fill height: Fit flow: Right spacing: 8
                        AccentBtn{text: "Send (demo)" on_click: || do_send()}
                        if archived { NavBtn{text: "Undo" on_click: || do_undo()} }
                        if archived == false { GhostBtn{text: "Archive" on_click: || do_archive()} }
                        NavBtn{text: "Open app" on_click: || set_depth("app")}
                    }
                    if msg_note != "" { Label{width: Fill height: Fit text: msg_note draw_text.color: #x1f9d55 draw_text.text_style.font_size: 12 draw_text.wrap: true} }
                    if archived { Label{width: Fill height: Fit text: "Archived (demo). Undo restores it." draw_text.color: #x5b6672 draw_text.text_style.font_size: 12 draw_text.wrap: true} }
                }
            }

            // ---------- L2 · full app view ----------
            if depth == "app" {
                View{width: Fill height: Fit flow: Right spacing: 8
                    if folder == "inbox" { AccentBtn{text: "Inbox" on_click: || set_folder("inbox")} } else { NavBtn{text: "Inbox" on_click: || set_folder("inbox")} }
                    if folder == "archived" { AccentBtn{text: "Archived" on_click: || set_folder("archived")} } else { NavBtn{text: "Archived" on_click: || set_folder("archived")} }
                    View{width: Fill height: Fit}
                    Label{text: "Mail" draw_text.color: #x1c2430 draw_text.text_style.font_size: 14}
                }
                SolidView{width: Fill height: 1 draw_bg.color: #xe2e7ec}
                if detail_open {
                    Label{width: Fill height: Fit text: title_of(open_id) draw_text.color: #x1c2430 draw_text.text_style.font_size: 18 draw_text.wrap: true}
                    Label{width: Fill height: Fit text: sender_of(open_id) draw_text.color: #x5b6672 draw_text.text_style.font_size: 12 draw_text.wrap: true}
                    SolidView{width: Fill height: 1 draw_bg.color: #xe2e7ec}
                    Label{width: Fill height: Fit text: body_of(open_id) draw_text.color: #x1c2430 draw_text.text_style.font_size: 14 draw_text.wrap: true}
                    Label{text: "Demo message · no real mail read or sent" draw_text.color: #x9aa4b0 draw_text.text_style.font_size: 11 draw_text.wrap: true}
                    View{width: Fill height: Fit flow: Right spacing: 8
                        NavBtn{text: "‹ Back to list" on_click: || close_detail()}
                    }
                }
                if detail_open == false {
                    if folder == "inbox" {
                        if archived == false {
                            RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 4 draw_bg.color: #xf7f9fb draw_bg.radius: 12
                                View{width: Fill height: Fit flow: Right spacing: 6
                                    Label{text: "Ana Rivera" draw_text.color: #x5b6672 draw_text.text_style.font_size: 13}
                                    View{width: Fill height: Fit}
                                    Label{text: "9:41" draw_text.color: #x9aa4b0 draw_text.text_style.font_size: 12}
                                }
                                Label{width: Fill height: Fit text: "Contract signing — Friday?" draw_text.color: #x1c2430 draw_text.text_style.font_size: 16 draw_text.wrap: true}
                                Label{width: Fill height: Fit text: "Can we sign by Friday?" draw_text.color: #x5b6672 draw_text.text_style.font_size: 13 draw_text.wrap: true}
                                OpenBtn{text: "Open ›" on_click: || open_detail("ana")}
                            }
                        }
                        RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 4 draw_bg.color: #xf7f9fb draw_bg.radius: 12
                            View{width: Fill height: Fit flow: Right spacing: 6
                                Label{text: "Design Weekly" draw_text.color: #x5b6672 draw_text.text_style.font_size: 13}
                                View{width: Fill height: Fit}
                                Label{text: "8:05" draw_text.color: #x9aa4b0 draw_text.text_style.font_size: 12}
                            }
                            Label{width: Fill height: Fit text: "Your Thursday digest is ready" draw_text.color: #x1c2430 draw_text.text_style.font_size: 16 draw_text.wrap: true}
                            Label{width: Fill height: Fit text: "Five short reads on card UI." draw_text.color: #x5b6672 draw_text.text_style.font_size: 13 draw_text.wrap: true}
                            OpenBtn{text: "Open ›" on_click: || open_detail("digest")}
                        }
                    }
                    if folder == "archived" {
                        if archived {
                            RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 4 draw_bg.color: #xf7f9fb draw_bg.radius: 12
                                View{width: Fill height: Fit flow: Right spacing: 6
                                    Label{text: "Ana Rivera" draw_text.color: #x5b6672 draw_text.text_style.font_size: 13}
                                    View{width: Fill height: Fit}
                                    Label{text: "9:41" draw_text.color: #x9aa4b0 draw_text.text_style.font_size: 12}
                                }
                                Label{width: Fill height: Fit text: "Contract signing — Friday?" draw_text.color: #x1c2430 draw_text.text_style.font_size: 16 draw_text.wrap: true}
                                Label{text: "Archived (demo)" draw_text.color: #x2f6fed draw_text.text_style.font_size: 12}
                                OpenBtn{text: "Open ›" on_click: || open_detail("ana")}
                            }
                        }
                        RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 4 draw_bg.color: #xf7f9fb draw_bg.radius: 12
                            View{width: Fill height: Fit flow: Right spacing: 6
                                Label{text: "Finance team" draw_text.color: #x5b6672 draw_text.text_style.font_size: 13}
                                View{width: Fill height: Fit}
                                Label{text: "Mon" draw_text.color: #x9aa4b0 draw_text.text_style.font_size: 12}
                            }
                            Label{width: Fill height: Fit text: "Quarterly report draft" draw_text.color: #x1c2430 draw_text.text_style.font_size: 16 draw_text.wrap: true}
                            Label{text: "Archived (demo)" draw_text.color: #x2f6fed draw_text.text_style.font_size: 12}
                            OpenBtn{text: "Open ›" on_click: || open_detail("finance")}
                        }
                    }
                }
            }

        }}
    }
}
