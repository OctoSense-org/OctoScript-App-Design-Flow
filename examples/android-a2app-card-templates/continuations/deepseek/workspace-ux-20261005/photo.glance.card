# ledger photo.glance@1.0.0
theme taskplan_light
# level:   L0
# profile: ui/l0
#
# PHOTO — reusable L0 compact glance card template.
# Renders the L0 "glance" presentation depth; the LANGUAGE level stays L0.
#
# Synthetic demo fixture only. This offline slice has no local-image route, so
# the media is shown as an honest UNAVAILABLE state. The metadata is fictional
# sample data; only the local favorite control is functional.

source photo sys.dataset(fields: [title, subtitle, summary, as_of])

state mode { shape: enum[brief, fav], initial: .brief }

event fav   { mode: set(.fav) }
event unfav { mode: set(.brief) }

copy app     { class: vocabulary, en: "Photos · demo", zh: "照片 · 演示" }
copy h_media { class: vocabulary, en: "IMAGE UNAVAILABLE" }
copy b_fav   { class: vocabulary, en: "Favorite" }
copy b_on    { class: vocabulary, en: "Favorited ✓" }
copy b_rm    { class: vocabulary, en: "Remove" }
copy loading { class: vocabulary, en: "Loading…", zh: "加载中…" }
copy offline { class: vocabulary, en: "Can't reach the network", zh: "网络不可用" }
copy empty   { class: vocabulary, en: "No photos" }
copy note    { class: model-copy, en: "Image can't be shown in this offline demo; the metadata is fictional sample data, and the favorite choice is a local control." }

view root Surface(pad: .tight) {
  Col(gap: 10) {
    Row(gap: 8, align: .center) {
      Icon(name: .camera, size: .row)
      TextCaption(text: copy.app, width: .fill)
      TextCaption(value: photo.as_of)
    }
    when photo.$state == .pending { TextBody(text: copy.loading) }
    when photo.$state == .failed  { TextBody(text: copy.offline) }
    when photo.$state == .ready {
      TextEyebrow(text: copy.h_media)
      TextTitle(text: photo.title, width: .fill)
      TextCaption(value: photo.subtitle, width: .fill)
      when mode == .brief {
        Row(gap: 8) {
          Chip(text: copy.b_fav, on_tap: fav, tone: .primary)
        }
      }
      when mode == .fav {
        Row(gap: 8, align: .center) {
          Icon(name: .heart, size: .row)
          TextTitle(text: copy.b_on)
        }
        TextCaption(text: copy.note, width: .fill)
        Row(gap: 8) {
          Chip(text: copy.b_rm, on_tap: unfav, tone: .primary)
        }
      }
    }
  }
}
