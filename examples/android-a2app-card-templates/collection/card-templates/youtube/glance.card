# ledger youtube.glance@1.0.0
theme taskplan_light
# level:   L0
# profile: ui/l0
#
# YOUTUBE — reusable L0 compact glance card template.
# Renders the L0 "glance" presentation depth; the LANGUAGE level stays L0.
#
# Synthetic demo fixture only. This offline slice has no video/player route, so
# the video is shown as an honest UNAVAILABLE state. The metadata is fictional
# sample data; only the local watch-later control is functional.

source video sys.dataset(fields: [title, subtitle, summary, as_of])

state mode { shape: enum[brief, saved], initial: .brief }

event save   { mode: set(.saved) }
event remove { mode: set(.brief) }

copy app     { class: vocabulary, en: "YouTube · demo", zh: "视频 · 演示" }
copy h_media { class: vocabulary, en: "VIDEO UNAVAILABLE" }
copy b_later { class: vocabulary, en: "Watch later" }
copy b_on    { class: vocabulary, en: "In Watch later ✓" }
copy b_rm    { class: vocabulary, en: "Remove" }
copy loading { class: vocabulary, en: "Loading…", zh: "加载中…" }
copy offline { class: vocabulary, en: "Can't reach the network", zh: "网络不可用" }
copy empty   { class: vocabulary, en: "No videos" }
copy note    { class: model-copy, en: "Video can't play in this offline demo; the metadata is fictional sample data, and the watch-later choice is a local control." }

view root Surface(pad: .tight) {
  Col(gap: 10) {
    Row(gap: 8, align: .center) {
      Icon(name: .play, size: .row)
      TextCaption(text: copy.app, width: .fill)
      TextCaption(value: video.as_of)
    }
    when video.$state == .pending { TextBody(text: copy.loading) }
    when video.$state == .failed  { TextBody(text: copy.offline) }
    when video.$state == .ready {
      TextEyebrow(text: copy.h_media)
      TextTitle(text: video.title, width: .fill)
      TextCaption(value: video.subtitle, width: .fill)
      when mode == .brief {
        Row(gap: 8) {
          Chip(text: copy.b_later, on_tap: save, tone: .primary)
        }
      }
      when mode == .saved {
        Row(gap: 8, align: .center) {
          Icon(name: .check, size: .row)
          TextTitle(text: copy.b_on)
        }
        TextCaption(text: copy.note)
        Row(gap: 8) {
          Chip(text: copy.b_rm, on_tap: remove, tone: .primary)
        }
      }
    }
  }
}
