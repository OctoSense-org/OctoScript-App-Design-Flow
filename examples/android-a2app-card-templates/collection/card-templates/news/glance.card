# ledger news.glance@1.0.0
theme taskplan_light
# level:   L0
# profile: ui/l0
#
# NEWS — reusable L0 compact glance card template.
# Renders the L0 "glance" presentation depth; the LANGUAGE level stays L0.
#
# Synthetic demo fixture only: no live feed, no network, no article fetched.
# A saved record is a LINK, not a downloaded article — the card says so.

source article sys.dataset(fields: [title, subtitle, summary, as_of, url1])

state mode { shape: enum[brief, saved], initial: .brief }

event save    { mode: set(.saved) }
event restore { mode: set(.brief) }

copy app     { class: vocabulary, en: "News · demo", zh: "新闻 · 演示" }
copy b_save  { class: vocabulary, en: "Save" }
copy b_saved { class: vocabulary, en: "Saved ✓" }
copy b_undo  { class: vocabulary, en: "Remove" }
copy loading { class: vocabulary, en: "Loading…", zh: "加载中…" }
copy offline { class: vocabulary, en: "Can't reach the network", zh: "网络不可用" }
copy empty   { class: vocabulary, en: "No stories" }
copy note    { class: model-copy, en: "Saving keeps only a link; no article is downloaded and nothing is sent." }

view root Surface(pad: .tight) {
  Col(gap: 10) {
    Row(gap: 8, align: .center) {
      TextCaption(text: copy.app, width: .fill)
      TextCaption(value: article.as_of)
    }
    when article.$state == .pending { TextBody(text: copy.loading) }
    when article.$state == .failed  { TextBody(text: copy.offline) }
    when article.$state == .ready {
      TextTitle(text: article.title, width: .fill)
      TextCaption(value: article.subtitle, width: .fill)
      when mode == .brief {
        Row(gap: 8) {
          Chip(text: copy.b_save, on_tap: save, tone: .primary)
        }
      }
      when mode == .saved {
        Row(gap: 8, align: .center) {
          Icon(name: .check, size: .row)
          TextTitle(text: copy.b_saved)
        }
        TextCaption(text: copy.note)
        Row(gap: 8) {
          Chip(text: copy.b_undo, on_tap: restore, tone: .primary)
        }
      }
    }
  }
}
