# ledger finance.glance@1.0.0
theme taskplan_light
# level:   L0
# profile: ui/l0
#
# FINANCE — reusable L0 compact glance card template.
# Renders the L0 "glance" presentation depth; the LANGUAGE level stays L0.
#
# Synthetic demo fixture only: no live quote, no trade, no account.
# Numbers, currency and as-of all come from explicit fixture data.

source quote sys.dataset(fields: [title, subtitle, metric1_label, metric1_value, as_of])

state mode { shape: enum[brief, watching], initial: .brief }

event watch   { mode: set(.watching) }
event unwatch { mode: set(.brief) }

copy app      { class: vocabulary, en: "Finance · demo", zh: "行情 · 演示" }
copy h_range  { class: vocabulary, en: "DAY RANGE" }copy b_watch  { class: vocabulary, en: "Watch" }
copy b_on     { class: vocabulary, en: "Watching ✓" }
copy b_remove { class: vocabulary, en: "Remove" }
copy loading  { class: vocabulary, en: "Loading…", zh: "加载中…" }
copy offline  { class: vocabulary, en: "Can't reach the network", zh: "网络不可用" }
copy empty    { class: vocabulary, en: "No quotes" }
copy note     { class: model-copy, en: "Demo quote only — not a live price, not investment advice." }

view root Surface(pad: .tight) {
  Col(gap: 10) {
    Row(gap: 8, align: .center) {
      TextCaption(text: copy.app, width: .fill)
      TextCaption(value: quote.as_of)
    }
    when quote.$state == .pending { TextBody(text: copy.loading) }
    when quote.$state == .failed  { TextBody(text: copy.offline) }
    when quote.$state == .ready {
      TextTitle(text: quote.title, width: .fill)
      TextTitle(text: quote.subtitle, width: .fill)
      Row(gap: 8, align: .center) {
        TextEyebrow(text: quote.metric1_label)
        TextCaption(value: quote.metric1_value, width: .fill)
      }
      when mode == .brief {
        Row(gap: 8) {
          Chip(text: copy.b_watch, on_tap: watch, tone: .primary)
        }
      }
      when mode == .watching {
        Row(gap: 8, align: .center) {
          Icon(name: .heart, size: .row)
          TextTitle(text: copy.b_on)
        }
        TextCaption(text: copy.note)
        Row(gap: 8) {
          Chip(text: copy.b_remove, on_tap: unwatch, tone: .primary)
        }
      }
    }
  }
}
