# ------------------------------------------------------------------------ main
def main():
    p = argparse.ArgumentParser(
        prog="tools/octo",
        description="Build, run, capture and check an OctoSense script app (wraps card-host and hub).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Docs: docs/QUICKSTART.md, docs/PUBLISHING.md, docs/SCRIPT-API.md",
    )
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")

    sub.add_parser("doctor", help="find hub and card-host, check python, print fixes")

    n = sub.add_parser("new", help="create an app from templates/script-app")
    n.add_argument("dir")
    n.add_argument("--id", help="manifest id, [a-z0-9.-]{1,64} (default: from the directory name)")
    n.add_argument("--name", help="display name (also the app's title label)")
    n.add_argument("--platform", action="append", choices=PLATFORMS, required=True,
                   help="target listing platform; repeat for more than one and verify each before publishing")
    n.add_argument("--system", action="store_true", help="allow an os.* id (system apps only; native/host namespaces remain reserved)")

    r = sub.add_parser("run", help="run a bundle in card-host with the remote-control bridge")
    r.add_argument("bundle")
    r.add_argument("--port", type=int, default=8141, help="MAKEPAD_REMOTE port (default 8141)")
    r.add_argument("--hidden", action="store_true", help="headless: never show or focus the window (MAKEPAD_HIDE_WINDOWS=1); drive and screenshot it over the bridge")
    r.add_argument("--system", action="store_true", help="admit as a system app (os.* ids, system ceilings)")
    r.add_argument("--detach", action="store_true", help="start in the background, wait until admitted and the first frame is drawn, return")
    r.add_argument("--no-stamp", action="store_true", help="do not pass --stamp (card-host then refuses a stale digest)")
    r.add_argument("--app-data", help="where the app's jail lives (default <bundle>/../.local-state)")
    r.add_argument("--static", action="append", metavar="PREFIX=DIR", help="card-host --static mount (repeatable)")
    r.add_argument("--timeout", type=float, default=90.0, help="--detach: seconds to wait (default 90)")

    s = sub.add_parser("shot", help="save a PNG of the running app's window (GET /g?raw=1)")
    s.add_argument("port", type=int)
    s.add_argument("out")
    s.add_argument("--host", default="127.0.0.1")
    s.add_argument("--timeout", type=float, default=30.0, help="seconds to wait for the app's widgets (default 30)")
    s.add_argument("--settle", type=float, default=2.0, help="seconds to wait for two identical frames in a row (default 2)")

    c = sub.add_parser("check", help="hub stamp, then hub check --allow-unsigned; nonzero on refusal")
    c.add_argument("bundle")
    c.add_argument("--catalog", metavar="PATH", help="forward the catalog path to hub check")
    c.add_argument("--publisher-key", action="append", default=[], metavar="KEY", help="forward a legacy publisher key (id=hex) to hub check, to check an existing key-signed bundle; never needed to publish (repeatable)")

    g = sub.add_parser("publish-github", help="install the GitHub release workflow; no signing key")
    g.add_argument("dir", help="app repository directory containing bundle/manifest.json")
    g.add_argument("--replace", action="store_true", help="replace an existing publishing workflow after reviewing it")

    sub.add_parser("package-help", help="print the publish checklist")

    args, extra = p.parse_known_args()
    if args.cmd != "check" and extra:
        p.error("unrecognized arguments: " + " ".join(extra))
    handlers = {
        "doctor": cmd_doctor,
        "new": cmd_new,
        "run": cmd_run,
        "shot": cmd_shot,
        "publish-github": cmd_publish_github,
        "package-help": cmd_package_help,
    }
    if args.cmd == "check":
        sys.exit(cmd_check(args, extra))
    if args.cmd in handlers:
        sys.exit(handlers[args.cmd](args))
    p.print_help()
    sys.exit(0)


if __name__ == "__main__":
    main()
