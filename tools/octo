#!/usr/bin/env python3
"""octo: build, run, capture and check an OctoSense script app.

A thin wrapper over the two real tools, `card-host` and `hub`, which are built
from OctoSense-App-Hub. It never decides admission itself: `octo check` prints
exactly what `hub check` prints and exits with its status.

    tools/octo doctor
    tools/octo new <dir> [--id ID] [--name NAME]
    tools/octo run <bundle> [--port N] [--hidden] [--system] [--detach] [--no-stamp] [--app-data DIR]
    tools/octo shot <port> <out.png>
    tools/octo check <bundle> [hub check flags ...]
    tools/octo package-help

Binaries are found, in order, from $OCTO_HUB / $OCTO_CARD_HOST, then
$OCTOSENSE_APP_HUB/target/release, $CARGO_TARGET_DIR/release,
$OCTOSENSE_APP_HUB/../target/release, ../OctoSense-App-Hub/target/release and
../target/release beside this repository, then PATH. Python 3.9+, no
third-party packages.
"""
import argparse
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
TEMPLATE = REPO / "templates" / "script-app"
ID_RE = re.compile(r"^[a-z0-9.-]{1,64}$")
PNG_MAGIC = b"\x89PNG\r\n\x1a\n"


# --------------------------------------------------------------------- finding
def hub_repo():
    """The App Hub checkout: $OCTOSENSE_APP_HUB, else a sibling of this repo."""
    env = os.environ.get("OCTOSENSE_APP_HUB")
    if env:
        return Path(env).expanduser().resolve()
    sibling = REPO.parent / "OctoSense-App-Hub"
    return sibling if sibling.is_dir() else None


def candidate_dirs():
    dirs = []
    repo = hub_repo()
    if repo:
        dirs.append(repo / "target" / "release")
    if os.environ.get("CARGO_TARGET_DIR"):
        dirs.append(Path(os.environ["CARGO_TARGET_DIR"]).expanduser() / "release")
    if repo:
        dirs.append(repo.parent / "target" / "release")
    dirs.append(REPO.parent / "OctoSense-App-Hub" / "target" / "release")
    dirs.append(REPO.parent / "target" / "release")
    seen, out = set(), []
    for d in dirs:
        key = str(d.resolve()) if d.exists() else str(d)
        if key not in seen:
            seen.add(key)
            out.append(d)
    return out


def is_octosense_hub(path):
    # GitHub's CLI is also called `hub`; ours prints this banner on `help`.
    try:
        out = subprocess.run([str(path), "help"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return "OctoSense app hub" in (out.stdout + out.stderr)


def find_binary(name, env_var):
    """(path or None, where it came from, list of places searched)."""
    searched = []
    explicit = os.environ.get(env_var)
    if explicit:
        p = Path(explicit).expanduser()
        searched.append(f"${env_var}={p}")
        if p.is_file() and os.access(p, os.X_OK):
            return p, f"${env_var}", searched
    for d in candidate_dirs():
        p = d / name
        searched.append(str(p))
        if p.is_file() and os.access(p, os.X_OK):
            if name == "hub" and not is_octosense_hub(p):
                continue
            return p, str(d), searched
    on_path = shutil.which(name)
    searched.append(f"PATH ({name})")
    if on_path:
        if name == "hub" and not is_octosense_hub(on_path):
            searched.append(f"{on_path} is not the OctoSense hub (GitHub's CLI is also named hub)")
        else:
            return Path(on_path), "PATH", searched
    return None, None, searched


def need(name, env_var):
    path, _, searched = find_binary(name, env_var)
    if path is None:
        die(f"{name} not found. Searched:\n  " + "\n  ".join(searched)
            + f"\nRun `tools/octo doctor` for how to build it, or set ${env_var}.")
    return path


def die(msg, code=1):
    print(f"octo: {msg}", file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------------- doctor
def cmd_doctor(args):
    ok = True
    print(f"octo doctor  (repo {REPO})")
    v = sys.version_info
    if v >= (3, 9):
        print(f"  [ok]   python {v.major}.{v.minor}.{v.micro}")
    else:
        ok = False
        print(f"  [fail] python {v.major}.{v.minor} is older than 3.9; install Python 3.9 or newer")

    repo = hub_repo()
    if repo and (repo / "Cargo.toml").is_file():
        print(f"  [ok]   App Hub checkout {repo}")
    else:
        print("  [info] no App Hub checkout found (set $OCTOSENSE_APP_HUB, or clone it beside this repo);"
              " only needed to build hub and card-host")

    for name, env_var in (("hub", "OCTO_HUB"), ("card-host", "OCTO_CARD_HOST")):
        path, where, searched = find_binary(name, env_var)
        if path:
            print(f"  [ok]   {name}: {path}  (from {where})")
        else:
            ok = False
            print(f"  [fail] {name} not found. Searched:")
            for s in searched:
                print(f"           {s}")

    cargo = shutil.which("cargo") or (str(Path.home() / ".cargo/bin/cargo") if (Path.home() / ".cargo/bin/cargo").exists() else None)
    print(f"  [{'ok' if cargo else 'info'}]   cargo: {cargo or 'not on PATH (needed only to build hub and card-host)'}"
          + ("" if shutil.which("cargo") or not cargo else "  -- add ~/.cargo/bin to PATH"))

    if (TEMPLATE / "bundle" / "manifest.json").is_file():
        print(f"  [ok]   template {TEMPLATE.relative_to(REPO)}")
    else:
        ok = False
        print(f"  [fail] template missing at {TEMPLATE}")

    if not ok:
        print("\nFix:")
        print("  1. Prepare the sibling sources and the App Hub checkout (docs/NATIVE-WORKSPACE.md, docs/QUICKSTART.md):")
        print("       <workspace>/OctoSense-App-Hub  <workspace>/makepad  <workspace>/octoscript-makepad  <workspace>/octoscript")
        print("  2. Build the two tools:")
        print("       cd <workspace>/OctoSense-App-Hub")
        print("       cargo build --release -p octosense-card-host -p octosense-app-hub")
        print("  3. Point octo at them if they are not found automatically:")
        print("       export OCTOSENSE_APP_HUB=<workspace>/OctoSense-App-Hub")
        print("       # or: export OCTO_HUB=/path/to/hub OCTO_CARD_HOST=/path/to/card-host")
        return 1
    print("\nready: tools/octo new <dir> && tools/octo run <dir>/bundle")
    return 0


# ------------------------------------------------------------------------- new
def cmd_new(args):
    dest = Path(args.dir).expanduser().resolve()
    if dest.exists() and any(dest.iterdir()):
        die(f"{dest} exists and is not empty; choose a new directory")
    app_id = args.id or re.sub(r"[^a-z0-9.-]+", "-", dest.name.lower()).strip("-.") or "my-app"
    if not ID_RE.match(app_id) or app_id.startswith(".") or ".." in app_id:
        die(f"id {app_id!r} must be 1-64 of [a-z0-9.-], not start with '.', and not contain '..'")
    if app_id.startswith("os.") and not args.system:
        die("ids under 'os.' are reserved for system apps (OctoSense-System-Apps); no store installs one. "
            "Pass --system only if you are developing a system app.")
    name = args.name or "My Notes"

    dest.mkdir(parents=True, exist_ok=True)
    shutil.copytree(TEMPLATE / "bundle", dest / "bundle")
    for extra in ("AGENTS.md", "CLAUDE.md", "GEMINI.md", ".gitignore"):
        src = TEMPLATE / extra
        if src.is_file():
            shutil.copy2(src, dest / extra)

    manifest_path = dest / "bundle" / "manifest.json"
    manifest = json.loads(manifest_path.read_text())
    manifest["id"] = app_id
    manifest["name"] = name
    manifest["version"] = "0.1.0"
    manifest["integrity"] = {"bundle_blake3": ""}
    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")

    main = dest / "bundle" / "main.splash"
    if args.name:
        main.write_text(main.read_text().replace('text: "My Notes"', "text: " + json.dumps(name), 1))

    hub, _, _ = find_binary("hub", "OCTO_HUB")
    if hub:
        subprocess.run([str(hub), "stamp", str(dest / "bundle")], check=True, stdout=subprocess.DEVNULL)
        stamped = "stamped"
    else:
        stamped = "NOT stamped (hub not found; `tools/octo run` stamps through card-host)"
    print(f"created {dest}")
    print(f"  id {app_id}, name {name!r}, version 0.1.0, bundle {stamped}")
    print("next:")
    print(f"  tools/octo run {dest / 'bundle'} --port 8141")
    print("  edit bundle/main.splash, bundle/listing.json (every placeholder), bundle/assets/icon.svg")
    return 0


# ---------------------------------------------------------------- the bridge
# Widgets card-host itself draws around the card; they exist before the app does.
HOST_CHROME = {"main_window", "caption_bar", "caption_label", "caption_icon", "label", "body", "card"}


def bridge_get(port, path, timeout=5.0, host="127.0.0.1"):
    """GET a remote-bridge route; bytes, or None when nothing answers."""
    try:
        with urllib.request.urlopen(f"http://{host}:{port}{path}", timeout=timeout) as r:
            return r.read()
    except (urllib.error.URLError, OSError, ValueError):
        return None


def bridge_json(port, path, timeout=5.0, host="127.0.0.1"):
    data = bridge_get(port, path, timeout, host)
    try:
        return json.loads(data) if data else None
    except ValueError:
        return None


def port_owner(port):
    """None when 127.0.0.1:port is free, else a description of what holds it."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(1.0)
        if s.connect_ex(("127.0.0.1", port)) != 0:
            return None
    info = bridge_json(port, "/s", timeout=2.0)
    if isinstance(info, dict) and "pid" in info:
        return f"{info.get('app', '?')} pid {info['pid']} (a makepad app with the remote bridge)"
    return "a process that is not a makepad remote bridge (find it with `lsof -nP -iTCP:%d -sTCP:LISTEN`)" % port


def app_ready(port, host="127.0.0.1"):
    """(ready, has_text) from /snap: has the app's own UI been laid out yet?"""
    snap = bridge_json(port, "/snap", timeout=3.0, host=host)
    widgets = (snap or {}).get("s") or []
    content = [w for w in widgets if w.get("i") not in HOST_CHROME and w.get("ty") != "Splash"]
    return bool(content), any((w.get("t") or "").strip() for w in content)


def wait_until_ready(port, timeout, host="127.0.0.1"):
    """Poll /snap until the app's widgets (with text) are laid out, then make
    sure one full frame has been presented after that. Returns a note or None.

    Right after admission the window can still show a half-built first frame
    and input can land before the widgets exist (#118)."""
    deadline = time.time() + timeout
    first_content = None
    note = None
    while True:
        ready, has_text = app_ready(port, host)
        now = time.time()
        if ready and first_content is None:
            first_content = now
        # A UI without any text is legal; give text 3 s to show up, then go on.
        if ready and (has_text or now - first_content > 3.0):
            if not has_text:
                note = "the app's widgets report no text"
            break
        if now > deadline:
            return "the app's widgets did not appear in /snap in time"
        time.sleep(0.05)
    # An input with wait=1 answers only after the next frame is drawn; a pointer
    # move outside the window changes nothing in the app.
    bridge_get(port, "/m?k=move&x=-1&y=-1&wait=1", timeout=5.0, host=host)
    return note


# ------------------------------------------------------------------------- run
def wait_for(log_path, proc, port, timeout):
    """Wait until this card-host's remote bridge is up and the bundle was
    admitted, or something failed. Returns (listening, admitted, error)."""
    deadline = time.time() + timeout
    listening = admitted = error = None
    want = re.compile(r"\[makepad-remote\] listening on 127\.0\.0\.1:%d pid=%d\b" % (port, proc.pid))
    while time.time() < deadline:
        text = log_path.read_text(errors="replace") if log_path.exists() else ""
        for line in text.splitlines():
            if want.search(line) and not listening:
                listening = line.strip()
            if "[makepad-remote] bind" in line and "failed" in line:
                error = line.strip()
            if "card-host:" in line and "admitted" in line and not admitted:
                admitted = line.strip()
            if "card-host: refused" in line or "did not lower" in line:
                error = line.strip()
        if error or (listening and admitted):
            break
        if proc.poll() is not None:
            error = error or f"card-host exited with status {proc.returncode}"
            break
        time.sleep(0.1)
    if not error and not admitted:
        error = f"card-host did not admit the bundle within {timeout:g}s"
    elif not error and not listening:
        error = f"card-host (pid {proc.pid}) never reported its remote bridge listening on 127.0.0.1:{port}"
    return listening, admitted, error


def port_busy_message(port, owner):
    return (f"port {port} is already taken by {owner}.\n"
            f"  Every curl/shot on {port} would reach that process, not the app you are starting.\n"
            f"  Quit it:  curl -s 127.0.0.1:{port}/quit      or pick another port: --port {port + 1}")


def cmd_run(args):
    bundle = Path(args.bundle).expanduser().resolve()
    if not (bundle / "manifest.json").is_file():
        die(f"{bundle} has no manifest.json; pass the bundle directory (…/bundle)")
    card_host = need("card-host", "OCTO_CARD_HOST")
    # card-host would start anyway, without a bridge, and every curl would
    # silently drive whatever already holds the port (#119).
    owner = port_owner(args.port)
    if owner:
        die(port_busy_message(args.port, owner))
    app_data = Path(args.app_data).expanduser().resolve() if args.app_data else bundle.parent / ".local-state"
    app_data.mkdir(parents=True, exist_ok=True)
    cmd = [str(card_host), "--bundle", str(bundle), "--app-data", str(app_data), "--allow-unsigned"]
    if not args.no_stamp:
        cmd.append("--stamp")
    if args.system:
        cmd.append("--system")
    for s in args.static or []:
        cmd += ["--static", s]
    env = dict(os.environ)
    env["MAKEPAD_REMOTE"] = str(args.port)
    if args.hidden:
        # Makepad's headless mode: the window is never shown or focused, and
        # the remote bridge (/snap, /click, /g screenshots) still works. Run
        # as many apps side by side as you like, each on its own --port.
        env["MAKEPAD_HIDE_WINDOWS"] = "1"
        env.pop("MAKEPAD_FOCUS", None)
    # card-host resolves its compiled-in resources relative to its workspace.
    repo = hub_repo()
    cwd = str(repo) if repo and repo.is_dir() else None
    print("octo: " + " ".join(cmd) + f"   (MAKEPAD_REMOTE={args.port}" + (", hidden window" if args.hidden else "") + ")", flush=True)

    if not args.detach:
        proc = subprocess.Popen(cmd, env=env, cwd=cwd)
        try:
            return proc.wait()
        except KeyboardInterrupt:
            proc.send_signal(signal.SIGINT)
            return proc.wait()

    log_path = app_data / "card-host.log"
    log = open(log_path, "w")
    started = time.time()
    proc = subprocess.Popen(cmd, env=env, cwd=cwd, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)

    def fail(msg):
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
        print(log_path.read_text(errors="replace")[-4000:])
        die(msg + f"\n  (stopped the card-host it started, pid {proc.pid}; log {log_path})")

    listening, admitted, error = wait_for(log_path, proc, args.port, args.timeout)
    if error:
        owner = port_owner(args.port) if "bind" in error else None
        fail(port_busy_message(args.port, owner) if owner else error)
    info = bridge_json(args.port, "/s")
    if not isinstance(info, dict) or info.get("pid") != proc.pid:
        fail(f"127.0.0.1:{args.port} is not answered by the card-host just started (pid {proc.pid}): /s said {info!r}")
    note = wait_until_ready(args.port, max(5.0, args.timeout - (time.time() - started)))
    if note and "did not appear" in note:
        fail(note)
    print(listening)
    print(admitted)
    print(f"ready: first frame drawn{'; ' + note if note else ''}")
    print(f"pid {proc.pid}  log {log_path}")
    print(f"drive it:  curl -s 127.0.0.1:{args.port}/snap   |   tools/octo shot {args.port} <out.png>   |   curl -s 127.0.0.1:{args.port}/quit")
    return 0


# ------------------------------------------------------------------------ shot
def grab_png(host, port, timeout):
    url = f"http://{host}:{port}/g?raw=1"
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            data = r.read()
    except (urllib.error.URLError, OSError) as e:
        die(f"GET {url} failed: {e}. Is the app running with MAKEPAD_REMOTE={port}?")
    if not data.startswith(PNG_MAGIC):
        die(f"{url} did not return a PNG: {data[:200]!r}")
    return data


def cmd_shot(args):
    if bridge_json(args.port, "/s", host=args.host) is None:
        die(f"nothing answers on {args.host}:{args.port}. Is the app running with MAKEPAD_REMOTE={args.port}?")
    # Never capture a half-built first frame (#118): wait for the app's widgets,
    # then grab until two frames in a row are identical (or --settle runs out,
    # e.g. for an app that animates all the time).
    note = wait_until_ready(args.port, args.timeout, host=args.host)
    if note and "did not appear" in note:
        die(note + f"; nothing captured. Check `curl -s {args.host}:{args.port}/snap`.")
    data = grab_png(args.host, args.port, args.timeout)
    deadline = time.time() + args.settle
    settled = False
    while time.time() < deadline:
        bridge_get(args.port, "/m?k=move&x=-1&y=-1&wait=1", timeout=5.0, host=args.host)
        again = grab_png(args.host, args.port, args.timeout)
        if again == data:
            settled = True
            break
        data = again
    out = Path(args.out).expanduser()
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_bytes(data)
    w = int.from_bytes(data[16:20], "big")
    h = int.from_bytes(data[20:24], "big")
    extra = "" if settled else f" (still changing after {args.settle:g}s, e.g. an animation; this is the last frame)"
    if note:
        extra += f" ({note})"
    print(f"wrote {out} ({w}x{h}, {len(data)} bytes){extra}. Look at it before you ship it.")
    return 0


# ----------------------------------------------------------------------- check
PLACEHOLDERS = ["example.com", "Replace with", "Replace this"]


def cmd_check(args, extra):
    bundle = Path(args.bundle).expanduser().resolve()
    if not (bundle / "manifest.json").is_file():
        die(f"{bundle} has no manifest.json")
    hub = need("hub", "OCTO_HUB")
    manifest = json.loads((bundle / "manifest.json").read_text())
    signed = bool((manifest.get("integrity") or {}).get("signature"))
    if signed:
        print("octo: the manifest is signed; not restamping (a restamp would invalidate the signature).")
    else:
        r = subprocess.run([str(hub), "stamp", str(bundle)], capture_output=True, text=True)
        if r.returncode != 0:
            print(r.stdout + r.stderr, end="")
            return r.returncode
        print(f"octo: hub stamp -> {r.stdout.strip()}")
    cmd = [str(hub), "check", str(bundle)]
    if not signed and "--allow-unsigned" not in extra:
        cmd.append("--allow-unsigned")
    cmd += extra
    print("octo: " + " ".join(cmd), flush=True)
    r = subprocess.run(cmd)
    # Things the gate does not look at, but a reviewer will.
    listing_path = bundle / "listing.json"
    if listing_path.is_file():
        text = listing_path.read_text()
        hits = [p for p in PLACEHOLDERS if p in text]
        if hits:
            print(f"octo: note: listing.json still holds template placeholders ({', '.join(hits)}); "
                  "the gate accepts them, a reviewer will not.")
    return r.returncode


